---
/**
 * Divisi & Bidang — Menampilkan rincian empat divisi pilar dalam HIMASTI.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';

const divisiList = (await getCollection('divisi')).sort(
  (a, b) => a.data.urutan - b.data.urutan
);
---

<BaseLayout
  title="Divisi & Bidang"
  description="Daftar dan tugas pokok divisi kepengurusan Himpunan Mahasiswa Sistem & Teknologi Informasi (HIMASTI) Cyber University."
>
  <!-- Page Hero Header -->
  <section class="pt-32 lg:pt-40 pb-16 lg:pb-20 bg-white">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-flex items-center rounded-full border border-gray-300 text-slate-700 px-3 py-1 text-xs font-medium tracking-[0.02em] mb-6">Divisi &amp; Bidang</span>
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-[52px] font-medium leading-[1.12] tracking-[-0.02em] text-navy-900">Divisi &amp; Bidang</h1>
        <p class="mt-4 text-base sm:text-lg text-slate-500 max-w-2xl leading-relaxed">
          Mengenal empat divisi yang menjadi penggerak pelaksanaan program kerja, kolaborasi, dan inovasi HIMASTI Cyber University Periode 2026/2027.
        </p>
      </div>
    </Container>
  </section>

  <!-- Section Divisi (white) -->
  <Section bg="white" class="py-20 lg:py-32">
    <Container>
      {divisiList.length > 0 ? (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
          {divisiList.map((divisi) => (
            <article
              id={divisi.data.slug}
              class="scroll-mt-24 rounded-[20px] border border-mist-100 border-l-4 border-l-navy-900 bg-white p-6 sm:p-8 shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:shadow-md hover:border-slate-500 hover:border-l-navy-900 flex flex-col justify-between"
            >
              <div>
                <span class="inline-flex items-center rounded-full border border-gray-300 text-slate-700 px-3 py-1 text-xs font-medium tracking-[0.02em] mb-3">
                  Divisi
                </span>
                <h2 class="font-heading text-2xl sm:text-3xl font-medium text-navy-900 mb-4">
                  {divisi.data.nama}
                </h2>
                <p class="text-slate-700 text-sm sm:text-base leading-relaxed mb-6">
                  {divisi.data.ringkasan ||
                    'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.'}
                </p>

                {divisi.data.tugas && divisi.data.tugas.length > 0 && (
                  <div class="mb-6">
                    <span class="inline-flex items-center rounded-full border border-gray-300 text-slate-700 px-2.5 py-0.5 text-xs font-medium tracking-[0.02em] mb-3">
                      Tugas Utama
                    </span>
                    <ul class="space-y-1.5 list-disc list-inside text-sm text-slate-700">
                      {divisi.data.tugas.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

              <div class="pt-4 mt-2 border-t border-mist-100">
                <span class="font-mono text-xs tracking-wider uppercase text-slate-500 block mb-0.5">
                  Kepala Divisi
                </span>
                <span class="font-heading font-medium text-navy-900 text-base">
                  {divisi.data.kepala}
                </span>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-center text-slate-700 italic">
          Data divisi belum tersedia.
        </p>
      )}
    </Container>
  </Section>
</BaseLayout>
