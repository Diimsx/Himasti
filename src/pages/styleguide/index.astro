---
/**
 * /_styleguide — Internal page to review all UI components.
 * Not indexed, not linked from navigation.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Stat from '../../components/ui/Stat.astro';
import DivisiCard from '../../components/ui/DivisiCard.astro';
import ProkerCard from '../../components/ui/ProkerCard.astro';
import PengurusCard from '../../components/ui/PengurusCard.astro';
---

<BaseLayout title="Styleguide" description="Panduan komponen internal" noindex={true}>

  <!-- ======================== COLORS ======================== -->
  <Section bg="white">
    <Container>
      <SectionHeader eyebrow="warna" title="Palet Warna" description="Token warna dari design.md" />
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-4">
        <div>
          <div class="h-20 rounded-xl bg-navy-900"></div>
          <p class="text-xs font-mono mt-2 text-center">navy-900<br/>#1E273B</p>
        </div>
        <div>
          <div class="h-20 rounded-xl bg-navy-800"></div>
          <p class="text-xs font-mono mt-2 text-center">navy-800<br/>#283348</p>
        </div>
        <div>
          <div class="h-20 rounded-xl bg-slate-700"></div>
          <p class="text-xs font-mono mt-2 text-center">slate-700<br/>#434E61</p>
        </div>
        <div>
          <div class="h-20 rounded-xl bg-slate-500"></div>
          <p class="text-xs font-mono mt-2 text-center">slate-500<br/>#657186</p>
        </div>
        <div>
          <div class="h-20 rounded-xl bg-gray-300"></div>
          <p class="text-xs font-mono mt-2 text-center">gray-300<br/>#C3C5C9</p>
        </div>
        <div>
          <div class="h-20 rounded-xl bg-mist-100"></div>
          <p class="text-xs font-mono mt-2 text-center">mist-100<br/>#E0E6E6</p>
        </div>
        <div>
          <div class="h-20 rounded-xl border border-gray-300 bg-white"></div>
          <p class="text-xs font-mono mt-2 text-center">white<br/>#FFFFFF</p>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">
        <div>
          <div class="h-20 rounded-xl bg-accent-dark"></div>
          <p class="text-xs font-mono mt-2 text-center">accent-dark<br/>#38BDF8</p>
        </div>
        <div>
          <div class="h-20 rounded-xl bg-accent-dark-hover"></div>
          <p class="text-xs font-mono mt-2 text-center">accent-dark-hover<br/>#7DD3FC</p>
        </div>
        <div>
          <div class="h-20 rounded-xl bg-accent-light"></div>
          <p class="text-xs font-mono mt-2 text-center">accent-light<br/>#0369A1</p>
        </div>
        <div>
          <div class="h-20 rounded-xl bg-accent-light-hover"></div>
          <p class="text-xs font-mono mt-2 text-center">accent-light-hover<br/>#075985</p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ======================== TYPOGRAPHY ======================== -->
  <Section bg="mist">
    <Container>
      <SectionHeader eyebrow="tipografi" title="Skala Tipografi" />
      <div class="space-y-6 max-w-3xl">
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">Display (hero) — Plus Jakarta Sans 700</p>
          <p class="font-heading text-[40px] md:text-[64px] font-bold leading-[1.1] text-navy-900">Display Heading</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">H1 — Plus Jakarta Sans 700</p>
          <p class="font-heading text-[32px] md:text-5xl font-bold leading-[1.15] text-navy-900">Heading One</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">H2 — Plus Jakarta Sans 700</p>
          <p class="font-heading text-[26px] md:text-4xl font-bold leading-[1.2] text-navy-900">Heading Two</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">H3 — Plus Jakarta Sans 600</p>
          <p class="font-heading text-xl md:text-2xl font-semibold leading-[1.3] text-navy-900">Heading Three</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">Body — Inter 400</p>
          <p class="text-base md:text-lg leading-[1.65] text-slate-700">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">Small — Inter 400</p>
          <p class="text-sm leading-[1.5] text-slate-700">Teks kecil untuk label dan keterangan tambahan.</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">Eyebrow — JetBrains Mono 500</p>
          <p class="font-mono text-xs tracking-[0.08em] uppercase font-medium text-accent-light">// eyebrow label</p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ======================== BUTTONS ======================== -->
  <Section bg="white">
    <Container>
      <SectionHeader eyebrow="komponen" title="Tombol" description="Primer dan sekunder, untuk latar terang" />
      <div class="flex flex-wrap gap-4 mb-8">
        <Button variant="primary" on="light">Primer Terang</Button>
        <Button variant="secondary" on="light">Sekunder Terang</Button>
        <Button variant="primary" on="light" href="#">Primer Link</Button>
        <Button variant="secondary" on="light" href="#">Sekunder Link</Button>
      </div>
    </Container>
  </Section>

  <Section bg="navy-900">
    <Container>
      <SectionHeader eyebrow="komponen" title="Tombol di Latar Gelap" dark />
      <div class="flex flex-wrap gap-4">
        <Button variant="primary" on="dark">Primer Gelap</Button>
        <Button variant="secondary" on="dark">Sekunder Gelap</Button>
        <Button variant="primary" on="dark" href="#">Primer Link</Button>
        <Button variant="secondary" on="dark" href="#">Sekunder Link</Button>
      </div>
    </Container>
  </Section>

  <!-- ======================== BADGES ======================== -->
  <Section bg="white">
    <Container>
      <SectionHeader eyebrow="komponen" title="Badge" />
      <div class="flex flex-wrap gap-3">
        <Badge variant="default">Default</Badge>
        <Badge variant="info">Berlangsung</Badge>
        <Badge variant="warning">Akan Datang</Badge>
        <Badge variant="success">Selesai</Badge>
      </div>
    </Container>
  </Section>

  <!-- ======================== STATS ======================== -->
  <Section bg="navy-900">
    <Container>
      <SectionHeader eyebrow="komponen" title="Statistik" dark />
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <Stat value="4" label="Divisi" dark />
        <Stat value="6" label="Program Kerja" dark />
        <Stat value="25" label="Pengurus" dark />
        <Stat value="2026" label="Periode" dark />
      </div>
    </Container>
  </Section>

  <!-- ======================== CARDS ======================== -->
  <Section bg="mist">
    <Container>
      <SectionHeader eyebrow="kartu" title="DivisiCard" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <DivisiCard
          nama="Kreasi & Inovasi"
          slug="kreasi-inovasi"
          kepala="Muhammad Nabil Nurfadillah"
          ringkasan="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        />
        <DivisiCard
          nama="Humas"
          slug="humas"
          kepala="Rayssa Ameyliananda"
          ringkasan="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        />
        <DivisiCard
          nama="Sarana & Prasarana"
          slug="sarpras"
          kepala="Radithya Akmalino Setiawan"
          ringkasan="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        />
        <DivisiCard
          nama="Media & Informasi"
          slug="medinfo"
          kepala="Ableir Benny Purba"
          ringkasan="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        />
      </div>
    </Container>
  </Section>

  <Section bg="white">
    <Container>
      <SectionHeader eyebrow="kartu" title="ProkerCard" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ProkerCard
          judul="Company Visit"
          slug="company-visit"
          ringkasan="Kunjungan ke perusahaan teknologi informasi untuk memperluas wawasan industri."
          waktu="Q2 2026"
          kategori="kunjungan"
          status="akan-datang"
        />
        <ProkerCard
          judul="HIMASTI Skill Development Program"
          slug="hsdp"
          ringkasan="Pengembangan kapasitas internal berbasis proyek kolaboratif."
          waktu="Sepanjang periode"
          kategori="pelatihan"
          status="berlangsung"
        />
        <ProkerCard
          judul="Webinar"
          slug="webinar"
          ringkasan="Seminar online dengan praktisi industri IT."
          waktu="Q2 2026"
          kategori="seminar"
          status="selesai"
        />
      </div>
    </Container>
  </Section>

  <Section bg="mist">
    <Container>
      <SectionHeader eyebrow="kartu" title="PengurusCard" />
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
        <PengurusCard
          nama="Adnan Syukur"
          jabatan="Ketua"
        />
        <PengurusCard
          nama="Muhammad Jayana"
          jabatan="Wakil Ketua"
        />
        <PengurusCard
          nama="Aqila Cindy Ananti"
          jabatan="Sekretaris"
        />
        <PengurusCard
          nama="Putri Ramadhani"
          jabatan="Bendahara"
        />
        <PengurusCard
          nama="Muhammad Nabil N."
          jabatan="Kepala Divisi"
          divisi="Kreasi & Inovasi"
        />
      </div>
    </Container>
  </Section>

  <!-- ======================== SECTION HEADERS ======================== -->
  <Section bg="white">
    <Container>
      <SectionHeader
        eyebrow="contoh"
        title="Section Header Center"
        description="Deskripsi opsional di bawah heading. Teks tetap terbaca dan proporsional."
        align="center"
      />
      <SectionHeader
        eyebrow="contoh"
        title="Section Header Left"
        description="Varian rata kiri untuk halaman detail."
        align="left"
      />
    </Container>
  </Section>

  <Section bg="navy-800">
    <Container>
      <SectionHeader
        eyebrow="contoh"
        title="Section Header Dark"
        description="Tampilan header di atas latar gelap."
        dark
      />
    </Container>
  </Section>

</BaseLayout>
