---
/**
 * /_styleguide — Internal page to review all UI components.
 * Not indexed, not linked from navigation.
 * Updated for design v3 "Layered Clean Tech".
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Stat from '../../components/ui/Stat.astro';
import DivisiCard from '../../components/ui/DivisiCard.astro';
import ProkerCard from '../../components/ui/ProkerCard.astro';
import PengurusCard from '../../components/ui/PengurusCard.astro';
---

<BaseLayout title="Styleguide" description="Panduan komponen internal" noindex={true}>

  <!-- ======================== COLORS ======================== -->
  <Section bg="white">
    <Container>
      <SectionHeader eyebrow="warna" title="Palet Warna v3" description="Token warna HIMASTI — tanpa accent, hanya navy-mist-slate" />
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4">
        <div>
          <div class="h-20 rounded-[20px] bg-navy-900"></div>
          <p class="text-xs font-mono mt-2 text-center">navy-900<br/>#1E273B</p>
        </div>
        <div>
          <div class="h-20 rounded-[20px] bg-navy-800"></div>
          <p class="text-xs font-mono mt-2 text-center">navy-800<br/>#283348</p>
        </div>
        <div>
          <div class="h-20 rounded-[20px] bg-slate-700"></div>
          <p class="text-xs font-mono mt-2 text-center">slate-700<br/>#434E61</p>
        </div>
        <div>
          <div class="h-20 rounded-[20px] bg-slate-500"></div>
          <p class="text-xs font-mono mt-2 text-center">slate-500<br/>#657186</p>
        </div>
        <div>
          <div class="h-20 rounded-[20px] bg-gray-300"></div>
          <p class="text-xs font-mono mt-2 text-center">gray-300<br/>#C3C5C9</p>
        </div>
        <div>
          <div class="h-20 rounded-[20px] bg-mist-100"></div>
          <p class="text-xs font-mono mt-2 text-center">mist-100<br/>#E0E6E6</p>
        </div>
        <div>
          <div class="h-20 rounded-[20px] bg-mist-50"></div>
          <p class="text-xs font-mono mt-2 text-center">mist-50<br/>#F3F5F5</p>
        </div>
        <div>
          <div class="h-20 rounded-[20px] border border-mist-100 bg-white"></div>
          <p class="text-xs font-mono mt-2 text-center">white<br/>#FFFFFF</p>
        </div>
      </div>

      <!-- Surfaces demo -->
      <h3 class="font-heading text-xl font-medium text-navy-900 mt-12 mb-4">Permukaan</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="surface-ink rounded-[20px] p-6 text-white text-sm">surface-ink (pulau gelap)</div>
        <div class="surface-glass rounded-[20px] p-6 text-white text-sm bg-navy-900">surface-glass (kaca)</div>
        <div class="surface-mist rounded-[20px] p-6 h-40 text-sm text-navy-900">surface-mist (hero)</div>
      </div>
    </Container>
  </Section>

  <!-- ======================== TYPOGRAPHY ======================== -->
  <Section bg="mist">
    <Container>
      <SectionHeader eyebrow="tipografi" title="Skala Tipografi v3" description="Heading ringan (500), editorial, dua nada" />
      <div class="space-y-6 max-w-3xl">
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">Display (hero) — Plus Jakarta Sans 500</p>
          <p class="font-heading text-[40px] md:text-[64px] font-medium leading-[1.08] tracking-[-0.03em] text-navy-900">Display <span class="text-slate-700">Heading</span></p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">H1 — Plus Jakarta Sans 500</p>
          <p class="font-heading text-[32px] md:text-[52px] font-medium leading-[1.12] tracking-[-0.02em] text-navy-900">Heading One</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">H2 — Plus Jakarta Sans 500</p>
          <p class="font-heading text-[28px] md:text-[44px] font-medium leading-[1.15] tracking-[-0.02em] text-navy-900">Heading Two</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">H3 — Plus Jakarta Sans 600</p>
          <p class="font-heading text-xl md:text-2xl font-semibold leading-[1.3] text-navy-900">Heading Three</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">Pernyataan — Plus Jakarta Sans 500</p>
          <p class="font-heading text-2xl md:text-[40px] font-medium leading-[1.3] tracking-[-0.01em] text-navy-900">Paragraf besar untuk pulau gelap.</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">Body — Inter 400</p>
          <p class="text-base md:text-lg leading-[1.65] text-slate-700">Teks isi utama untuk paragraf dan deskripsi. Lebar baris 65–75 karakter.</p>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">Pil Label — Inter 500</p>
          <span class="inline-flex items-center rounded-full border border-gray-300 text-slate-700 px-3 py-1 text-xs font-medium tracking-[0.02em]">Pil Label</span>
        </div>
        <div>
          <p class="text-xs font-mono text-slate-500 mb-1">Angka — JetBrains Mono 500</p>
          <p class="font-mono text-[40px] md:text-[64px] font-medium leading-none tracking-[-0.02em] text-navy-900">2026</p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ======================== BUTTONS ======================== -->
  <Section bg="white">
    <Container>
      <SectionHeader eyebrow="komponen" title="Tombol" description="Primer dan sekunder, untuk latar terang" />
      <div class="flex flex-wrap gap-4 mb-8">
        <Button variant="primary" on="light">Primer Terang</Button>
        <Button variant="secondary" on="light">Sekunder Terang</Button>
        <Button variant="primary" on="light" href="#">Primer Link</Button>
        <Button variant="secondary" on="light" href="#">Sekunder Link</Button>
      </div>
    </Container>
  </Section>

  <Section bg="navy-900">
    <Container>
      <SectionHeader eyebrow="komponen" title="Tombol di Latar Gelap" dark />
      <div class="flex flex-wrap gap-4">
        <Button variant="primary" on="dark">Primer Gelap</Button>
        <Button variant="secondary" on="dark">Sekunder Gelap</Button>
        <Button variant="primary" on="dark" href="#">Primer Link</Button>
        <Button variant="secondary" on="dark" href="#">Sekunder Link</Button>
      </div>
    </Container>
  </Section>

  <!-- ======================== BADGES ======================== -->
  <Section bg="white">
    <Container>
      <SectionHeader eyebrow="komponen" title="Badge Status" description="Palet HIMASTI, tanpa warna eksternal" />
      <div class="flex flex-wrap gap-3">
        <Badge variant="default">Default</Badge>
        <Badge variant="akan-datang">Akan Datang</Badge>
        <Badge variant="berlangsung">Berlangsung</Badge>
        <Badge variant="selesai">Selesai</Badge>
      </div>
    </Container>
  </Section>

  <!-- ======================== STATS ======================== -->
  <section class="px-2 lg:px-3 py-4">
    <div class="surface-ink rounded-[32px] lg:rounded-[40px] shadow-xl py-20 lg:py-32 relative overflow-hidden">
      <div class="absolute inset-0 bg-dots-dark pointer-events-none" aria-hidden="true"></div>
      <Container>
        <SectionHeader eyebrow="komponen" title="Statistik" dark />
        <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-8">
          <Stat value="4" label="Divisi" dark />
          <Stat value="6" label="Program Kerja" dark />
          <Stat value="25" label="Pengurus" dark />
          <Stat value="2026" label="Periode" dark />
        </div>
      </Container>
    </div>
  </section>

  <!-- ======================== CARDS ======================== -->
  <Section bg="mist">
    <Container>
      <SectionHeader eyebrow="kartu" title="DivisiCard" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <DivisiCard
          nama="Kreasi & Inovasi"
          slug="kreasi-inovasi"
          kepala="Muhammad Nabil Nurfadillah"
          ringkasan="Pengembangan kreativitas dan inovasi mahasiswa."
        />
        <DivisiCard
          nama="Humas"
          slug="humas"
          kepala="Rayssa Ameyliananda"
          ringkasan="Hubungan masyarakat dan komunikasi eksternal."
        />
        <DivisiCard
          nama="Sarana & Prasarana"
          slug="sarpras"
          kepala="Radithya Akmalino Setiawan"
          ringkasan="Pengelolaan sarana dan prasarana organisasi."
        />
        <DivisiCard
          nama="Media & Informasi"
          slug="medinfo"
          kepala="Ableir Benny Purba"
          ringkasan="Pengelolaan media digital dan informasi."
          dark
        />
      </div>
    </Container>
  </Section>

  <Section bg="white">
    <Container>
      <SectionHeader eyebrow="kartu" title="ProkerCard" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ProkerCard
          judul="Company Visit"
          slug="company-visit"
          ringkasan="Kunjungan ke perusahaan teknologi informasi untuk memperluas wawasan industri."
          waktu="Q2 2026"
          kategori="kunjungan"
          status="akan-datang"
        />
        <ProkerCard
          judul="HIMASTI Skill Development Program"
          slug="hsdp"
          ringkasan="Pengembangan kapasitas internal berbasis proyek kolaboratif."
          waktu="Sepanjang periode"
          kategori="pelatihan"
          status="berlangsung"
        />
        <ProkerCard
          judul="Webinar"
          slug="webinar"
          ringkasan="Seminar online dengan praktisi industri IT."
          waktu="Q2 2026"
          kategori="seminar"
          status="selesai"
        />
      </div>
    </Container>
  </Section>

  <Section bg="mist">
    <Container>
      <SectionHeader eyebrow="kartu" title="PengurusCard" />
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
        <PengurusCard
          nama="Adnan Syukur"
          jabatan="Ketua"
        />
        <PengurusCard
          nama="Muhammad Jayana"
          jabatan="Wakil Ketua"
        />
        <PengurusCard
          nama="Aqila Cindy Ananti"
          jabatan="Sekretaris"
        />
        <PengurusCard
          nama="Putri Ramadhani"
          jabatan="Bendahara"
        />
        <PengurusCard
          nama="Muhammad Nabil N."
          jabatan="Kepala Divisi"
          divisi="Kreasi & Inovasi"
        />
      </div>
    </Container>
  </Section>

  <!-- ======================== SECTION HEADERS ======================== -->
  <Section bg="white">
    <Container>
      <SectionHeader
        eyebrow="contoh"
        title="Section Header Center"
        description="Deskripsi opsional di bawah heading. Teks tetap terbaca dan proporsional."
        align="center"
      />
      <SectionHeader
        eyebrow="contoh"
        title="Section Header Left"
        description="Varian rata kiri untuk halaman detail."
        align="left"
      />
    </Container>
  </Section>

  <section class="px-2 lg:px-3 py-4">
    <div class="surface-ink rounded-[32px] lg:rounded-[40px] shadow-xl py-20 lg:py-32 relative overflow-hidden">
      <Container>
        <SectionHeader
          eyebrow="contoh"
          title="Section Header Dark (Island)"
          description="Tampilan header di atas pulau gelap."
          dark
        />
      </Container>
    </div>
  </section>

</BaseLayout>
