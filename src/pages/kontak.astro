---
/**
 * Kontak — Halaman kontak resmi HIMASTI.
 * Menyediakan form pengiriman pesan, tautan media sosial resmi (Instagram, LinkedIn),
 * serta peta interaktif lokasi Cyber University.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import settings from '../content/settings.json';

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(settings.alamat)}`;
---

<BaseLayout
  title="Kontak"
  description="Hubungi Himpunan Mahasiswa Sistem & Teknologi Informasi (HIMASTI) Cyber University melalui formulir pesan, kanal sosial resmi, dan peta lokasi kampus."
>
  <!-- Page Hero Header -->
  <section class="pt-32 lg:pt-40 pb-12 lg:pb-16 bg-white border-b border-mist-100">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-flex items-center rounded-full border border-gray-300 text-slate-700 px-3 py-1 text-xs font-medium tracking-[0.02em] mb-4">
          Hubungi Kami
        </span>
        <h1 class="type-heading-primary text-navy-900">Kontak &amp; Lokasi</h1>
        <p class="mt-4 type-body-lead text-slate-700 max-w-2xl leading-relaxed">
          Punya pertanyaan seputar kegiatan, inisiatif kemitraan, atau kolaborasi dengan HIMASTI Cyber University? Silakan kirimkan pesan melalui formulir atau kanal resmi kami di bawah ini.
        </p>
      </div>
    </Container>
  </section>

  <!-- Section Utama: Form Kontak + Maps & Kontak HIMASTI -->
  <Section bg="white" class="py-14 lg:py-24">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        <!-- Kolom Kiri (lg:col-span-7): Form Kontak Saja -->
        <div class="lg:col-span-7">
          <div class="rounded-[24px] border border-mist-100 bg-white p-6 sm:p-10 shadow-sm">
            <div class="mb-8">
              <span class="inline-flex items-center rounded-full bg-mist-50 border border-mist-100 text-slate-700 px-3 py-1 text-xs font-medium tracking-[0.02em] mb-3">
                Formulir Komunikasi
              </span>
              <h2 class="type-heading-secondary text-navy-900">
                Kirimkan Pesan
              </h2>
              <p class="mt-2 text-sm sm:text-base text-slate-700 leading-relaxed">
                Isi formulir di bawah ini. Pesan Anda akan terkirim langsung ke kotak surat resmi kepengurusan HIMASTI.
              </p>
            </div>

            <form id="contact-form" class="space-y-5">
              <div>
                <label for="name" class="block text-xs font-mono uppercase tracking-wider text-slate-500 mb-2">
                  Nama Lengkap <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Contoh: Budi Pratama"
                  class="w-full rounded-[14px] border border-mist-100 bg-white px-4 py-3 text-sm text-navy-900 placeholder:text-slate-400 focus:border-navy-900 focus:outline-none focus:ring-1 focus:ring-navy-900 transition-colors"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-mono uppercase tracking-wider text-slate-500 mb-2">
                  Alamat Email <span class="text-rose-600">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="nama@email.com"
                  class="w-full rounded-[14px] border border-mist-100 bg-white px-4 py-3 text-sm text-navy-900 placeholder:text-slate-400 focus:border-navy-900 focus:outline-none focus:ring-1 focus:ring-navy-900 transition-colors"
                />
              </div>

              <div>
                <label for="subject" class="block text-xs font-mono uppercase tracking-wider text-slate-500 mb-2">
                  Subjek / Keperluan <span class="text-rose-600">*</span>
                </label>
                <select
                  id="subject"
                  name="subject"
                  required
                  class="w-full rounded-[14px] border border-mist-100 bg-white px-4 py-3 text-sm text-navy-900 focus:border-navy-900 focus:outline-none focus:ring-1 focus:ring-navy-900 transition-colors"
                >
                  <option value="" disabled selected>Pilih keperluan komunikasi...</option>
                  <option value="Kolaborasi / Kemitraan">Kolaborasi / Kemitraan Kegiatan</option>
                  <option value="Program Kerja">Pertanyaan Seputar Program Kerja</option>
                  <option value="Mahasiswa STI">Pertanyaan Mahasiswa STI</option>
                  <option value="Lainnya">Keperluan Lainnya</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-xs font-mono uppercase tracking-wider text-slate-500 mb-2">
                  Isi Pesan <span class="text-rose-600">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Tuliskan pesan, rincian pertanyaan, atau usulan kolaborasi Anda secara jelas..."
                  class="w-full rounded-[14px] border border-mist-100 bg-white px-4 py-3 text-sm text-navy-900 placeholder:text-slate-400 focus:border-navy-900 focus:outline-none focus:ring-1 focus:ring-navy-900 transition-colors resize-y"
                ></textarea>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  id="submit-btn"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full bg-navy-900 text-white text-sm font-medium hover:bg-navy-800 active:scale-[0.98] transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900 cursor-pointer shadow-sm"
                >
                  <span>Kirim Pesan Sekarang</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </div>

              <!-- Feedback Notice -->
              <div id="form-feedback" class="hidden mt-4 p-4 rounded-[14px] bg-mist-50 border border-mist-100 text-sm text-navy-900">
                <p class="font-medium">Membuka aplikasi surel Anda...</p>
                <p class="text-xs text-slate-500 mt-1">Jika klien surel tidak terbuka secara otomatis, Anda dapat mengirim pesan langsung ke <a href={`mailto:${settings.email}`} class="underline font-mono">{settings.email}</a>.</p>
              </div>
            </form>
          </div>
        </div>

        <!-- Kolom Kanan (lg:col-span-5): Kontak HIMASTI (IG, LinkedIn) & Maps Lokasi -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Card Kontak HIMASTI (Instagram, LinkedIn, Email) -->
          <div class="rounded-[24px] border border-mist-100 bg-white p-6 sm:p-7 shadow-sm">
            <span class="inline-flex items-center rounded-full bg-mist-50 border border-mist-100 text-slate-700 px-3 py-1 text-xs font-medium tracking-[0.02em] mb-4">
              Kanal Resmi
            </span>
            <h3 class="font-heading text-xl font-medium text-navy-900 mb-2">
              Kontak HIMASTI
            </h3>
            <p class="text-sm text-slate-700 leading-relaxed mb-6">
              Ikuti kabar terbaru dan jalin komunikasi dengan kami melalui kanal jejaring sosial resmi:
            </p>

            <div class="space-y-3">
              <!-- Instagram -->
              {settings.instagram && (
                <a
                  href={settings.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between p-3.5 rounded-[16px] bg-mist-50 border border-mist-100 hover:border-slate-400 hover:bg-white transition-all"
                  aria-label="Instagram HIMASTI Cyber University"
                >
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-navy-900 text-white flex items-center justify-center shrink-0">
                      <SocialIcon name="instagram" class="w-5 h-5" />
                    </div>
                    <div>
                      <p class="text-xs font-mono uppercase tracking-wider text-slate-500">Instagram</p>
                      <p class="text-sm font-medium text-navy-900 group-hover:underline">@himasticyberuniv</p>
                    </div>
                  </div>
                  <svg class="w-4 h-4 text-slate-500 group-hover:translate-x-1 group-hover:text-navy-900 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}

              <!-- LinkedIn -->
              {settings.linkedin && (
                <a
                  href={settings.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between p-3.5 rounded-[16px] bg-mist-50 border border-mist-100 hover:border-slate-400 hover:bg-white transition-all"
                  aria-label="LinkedIn HIMASTI Cyber University"
                >
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-navy-900 text-white flex items-center justify-center shrink-0">
                      <SocialIcon name="linkedin" class="w-5 h-5" />
                    </div>
                    <div>
                      <p class="text-xs font-mono uppercase tracking-wider text-slate-500">LinkedIn</p>
                      <p class="text-sm font-medium text-navy-900 group-hover:underline">HIMASTI Cyber University</p>
                    </div>
                  </div>
                  <svg class="w-4 h-4 text-slate-500 group-hover:translate-x-1 group-hover:text-navy-900 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}

              <!-- Email -->
              {settings.email && (
                <a
                  href={`mailto:${settings.email}`}
                  class="group flex items-center justify-between p-3.5 rounded-[16px] bg-mist-50 border border-mist-100 hover:border-slate-400 hover:bg-white transition-all"
                  aria-label="Email Resmi HIMASTI"
                >
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-navy-900 text-white flex items-center justify-center shrink-0">
                      <SocialIcon name="email" class="w-5 h-5" />
                    </div>
                    <div>
                      <p class="text-xs font-mono uppercase tracking-wider text-slate-500">Email Resmi</p>
                      <p class="text-sm font-medium text-navy-900 group-hover:underline">{settings.email}</p>
                    </div>
                  </div>
                  <svg class="w-4 h-4 text-slate-500 group-hover:translate-x-1 group-hover:text-navy-900 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              )}
            </div>
          </div>

          <!-- Card Maps Lokasi Cyber University -->
          <div class="rounded-[24px] border border-mist-100 bg-white p-6 sm:p-7 shadow-sm">
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="inline-flex items-center rounded-full bg-mist-50 border border-mist-100 text-slate-700 px-3 py-1 text-xs font-medium tracking-[0.02em]">
                Lokasi Kampus
              </span>
              <a
                href={mapsHref}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium text-navy-900 hover:underline inline-flex items-center gap-1"
              >
                Buka di Maps
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            <h3 class="font-heading text-lg font-medium text-navy-900 mb-2">
              Cyber University
            </h3>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed mb-4">
              {settings.alamat}
            </p>

            <!-- Iframe Google Maps -->
            <div class="w-full h-64 rounded-[16px] overflow-hidden border border-mist-100 bg-mist-100">
              <iframe
                title="Peta Lokasi Kampus Cyber University"
                src="https://maps.google.com/maps?q=Cyber+University+Jl+TB+Simatupang+No+6+Jakarta+Selatan&t=&z=15&ie=UTF8&iwloc=&output=embed"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('form-feedback');

    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('name') as HTMLInputElement)?.value.trim() ?? '';
      const email = (document.getElementById('email') as HTMLInputElement)?.value.trim() ?? '';
      const subject = (document.getElementById('subject') as HTMLSelectElement)?.value ?? '';
      const message = (document.getElementById('message') as HTMLTextAreaElement)?.value.trim() ?? '';

      const recipient = 'himasti@cyber-univ.ac.id';
      const mailtoSubject = encodeURIComponent(`[Website HIMASTI] ${subject} - ${name}`);
      const mailtoBody = encodeURIComponent(
        `Nama: ${name}\nEmail: ${email}\nKeperluan: ${subject}\n\nPesan:\n${message}`
      );

      if (feedback) {
        feedback.classList.remove('hidden');
      }

      // Open user's email client with pre-filled content
      window.location.href = `mailto:${recipient}?subject=${mailtoSubject}&body=${mailtoBody}`;
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
