---
/**
 * Detail Berita — Halaman artikel berita dan pengumuman individual.
 * Menggunakan getStaticPaths untuk menghasilkan rute dinamis secara statis.
 */
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Prose from '../../components/ui/Prose.astro';

export const getStaticPaths = (async () => {
  const beritaEntries = await getCollection('berita');
  return beritaEntries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = entry.data.tanggal.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${entry.data.judul} — Berita`}
  description={entry.data.ringkasan}
>
  <!-- Page Hero Header -->
  <section class="pt-24 sm:pt-28 lg:pt-32 pb-8 sm:pb-10 lg:pb-12 bg-white border-b border-mist-100">
    <Container>
      <!-- Back Link -->
      <a
        href="/berita"
        class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-slate-500 hover:text-navy-900 transition-colors mb-5 focus-visible:outline-2 focus-visible:outline-navy-900"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Kembali ke Berita
      </a>

      <!-- Title -->
      <h1 class="type-heading-secondary text-navy-900 mb-3 max-w-4xl">
        {entry.data.judul}
      </h1>

      <!-- Date & Author Metadata -->
      <div class="flex items-center gap-2 text-xs sm:text-sm font-mono text-slate-500">
        <time datetime={entry.data.tanggal.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>Ditulis oleh {entry.data.penulis}</span>
        {entry.data.kategori && (
          <>
            <span aria-hidden="true">·</span>
            <span class="capitalize">{entry.data.kategori}</span>
          </>
        )}
      </div>
    </Container>
  </section>

  <!-- Content Section -->
  <Section bg="white" class="py-10 sm:py-12 lg:py-16">
    <Container>
      <div class="max-w-3xl">
        {entry.data.sampul && (
          <div class="mb-10 rounded-[20px] overflow-hidden aspect-video border border-mist-100 shadow-sm">
            <Image
              src={entry.data.sampul}
              alt={entry.data.judul}
              width={960}
              height={540}
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <Prose>
          <Content />
        </Prose>
      </div>
    </Container>
  </Section>
</BaseLayout>
