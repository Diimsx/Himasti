---
/**
 * Struktur Organisasi — Struktur kepengurusan HIMASTI Periode 2026/2027.
 * Menampilkan Pembina, Pengurus Inti, dan 4 Divisi.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PengurusCard from '../components/ui/PengurusCard.astro';

const allPengurus = await getCollection('pengurus');

// Pengurus inti: pengurus tanpa divisi
const pengurusInti = allPengurus
  .filter((p) => !p.data.divisi)
  .sort((a, b) => a.data.urutan - b.data.urutan);

// Daftar nama divisi sesuai data
const divisiNames = [
  'Kreasi & Inovasi',
  'Humas',
  'Sarana & Prasarana',
  'Media & Informasi',
];
---

<BaseLayout
  title="Struktur Organisasi"
  description="Susunan pengurus dan struktur organisasi Himpunan Mahasiswa Sistem & Teknologi Informasi (HIMASTI) Cyber University Periode 2026/2027."
>
  <!-- Hero-like Header -->
  <section class="bg-navy-900 text-white py-16 lg:py-24 border-b border-navy-800">
    <Container>
      <div class="max-w-3xl">
        <p class="font-mono text-xs tracking-[0.08em] uppercase font-medium text-accent-dark mb-3">
          // struktur organisasi
        </p>
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">
          Struktur Organisasi
        </h1>
        <p class="mt-4 text-base sm:text-lg text-gray-300 max-w-2xl leading-relaxed">
          Struktur kepengurusan Himpunan Mahasiswa Sistem &amp; Teknologi Informasi (HIMASTI) Cyber University Periode 2026/2027.
        </p>
      </div>
    </Container>
  </section>

  <!-- Section Pembina (white) -->
  <Section bg="white">
    <Container>
      <SectionHeader
        eyebrow="pembina"
        title="Pembina HIMASTI"
        description="Dosen pembina yang mengarahkan dan membimbing jalannya roda organisasi."
        align="center"
      />
      <!-- Prominent Pembina Card -->
      <div class="max-w-md mx-auto">
        <div class="rounded-xl border border-gray-300 bg-white p-6 sm:p-8 text-center shadow-xs">
          <div class="w-24 h-24 mx-auto mb-4 rounded-full bg-mist-100 flex items-center justify-center text-slate-500">
            <svg
              class="w-12 h-12"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
              />
            </svg>
          </div>
          <p class="font-mono text-xs tracking-[0.08em] uppercase font-medium text-accent-light mb-1">
            // dosen pembina
          </p>
          <h3 class="font-heading text-xl sm:text-2xl font-bold text-navy-900">
            Neneng Rachmalia Feta, M.Kom.
          </h3>
          <p class="text-sm sm:text-base text-slate-700 mt-1">
            Pembina HIMASTI Periode 2026/2027
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Section Pengurus Inti (mist-100) -->
  <Section bg="mist">
    <Container>
      <SectionHeader
        eyebrow="pengurus inti"
        title="Pengurus Inti"
        description="Pimpinan pusat yang mengoordinasikan seluruh pergerakan dan arah strategis HIMASTI."
        align="center"
      />
      {pengurusInti.length > 0 ? (
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          {pengurusInti.map((p) => (
            <PengurusCard
              nama={p.data.nama}
              jabatan={p.data.jabatan}
              divisi={p.data.divisi}
              foto={p.data.foto}
            />
          ))}
        </div>
      ) : (
        <p class="text-center text-slate-700 italic">
          Data pengurus inti belum tersedia.
        </p>
      )}
    </Container>
  </Section>

  <!-- Section per Divisi (alternating white/mist) -->
  {divisiNames.map((divisiName, idx) => {
    const divisiMembers = allPengurus
      .filter((p) => p.data.divisi === divisiName)
      .sort((a, b) => a.data.urutan - b.data.urutan);
    const bgVariant = idx % 2 === 0 ? 'white' : 'mist';

    return (
      <Section bg={bgVariant}>
        <Container>
          <div class="mb-8">
            <p class="font-mono text-xs tracking-[0.08em] uppercase font-medium text-accent-light mb-2">
              // divisi
            </p>
            <h3 class="font-heading text-2xl sm:text-3xl font-bold text-navy-900">
              {divisiName}
            </h3>
          </div>
          {divisiMembers.length > 0 ? (
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
              {divisiMembers.map((member) => (
                <PengurusCard
                  nama={member.data.nama}
                  jabatan={member.data.jabatan}
                  divisi={member.data.divisi}
                  foto={member.data.foto}
                />
              ))}
            </div>
          ) : (
            <p class="text-slate-700 italic">
              Daftar anggota divisi akan segera diperbarui.
            </p>
          )}
        </Container>
      </Section>
    );
  })}
</BaseLayout>
