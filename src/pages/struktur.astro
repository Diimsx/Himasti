---
/**
 * Struktur Organisasi — Struktur kepengurusan HIMASTI Periode 2026/2027.
 * Menampilkan Pembina, Pengurus Inti (layout grid rapih & proporsional),
 * dan 4 Kepala Divisi berjajar menyamping yang menautkan ke halaman detail divisi.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';

const allPengurus = await getCollection('pengurus');
const allDivisi = await getCollection('divisi');

// Urutkan divisi sesuai urutan
const sortedDivisi = allDivisi.sort((a, b) => (a.data.urutan ?? 0) - (b.data.urutan ?? 0));

// Pengurus inti: pengurus tanpa divisi
const pengurusInti = allPengurus
  .filter((p) => !p.data.divisi)
  .sort((a, b) => a.data.urutan - b.data.urutan);

// Kepala per divisi
const kepalaDivisiList = sortedDivisi.map((div) => {
  const kepalaPengurus = allPengurus.find(
    (p) =>
      p.data.divisi?.toLowerCase() === div.data.nama.toLowerCase() &&
      p.data.jabatan.toLowerCase().includes('kepala')
  ) || allPengurus.find(
    (p) => p.data.divisi?.toLowerCase() === div.data.nama.toLowerCase()
  );

  return {
    divisiNama: div.data.nama,
    slug: div.data.slug,
    ringkasan: div.data.ringkasan,
    nama: kepalaPengurus?.data.nama ?? div.data.kepala,
    jabatan: kepalaPengurus?.data.jabatan ?? 'Kepala Divisi',
    foto: kepalaPengurus?.data.foto,
    angkatan: kepalaPengurus?.data.angkatan,
  };
});

const monogram = (nama: string) =>
  nama
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
---

<BaseLayout
  title="Struktur Organisasi"
  description="Susunan pengurus dan struktur organisasi Himpunan Mahasiswa Sistem & Teknologi Informasi (HIMASTI) Cyber University Periode 2026/2027."
>
  <!-- Page Hero Header -->
  <section class="pt-24 sm:pt-28 lg:pt-32 pb-8 sm:pb-10 lg:pb-12 bg-white border-b border-mist-100">
    <Container>
      <div class="max-w-3xl">
        <h1 class="type-heading-primary text-navy-900">Struktur Organisasi</h1>
        <p class="mt-3 type-body-lead text-slate-700 max-w-2xl leading-relaxed">
          Struktur kepengurusan Himpunan Mahasiswa Sistem &amp; Teknologi Informasi (HIMASTI) Cyber University Kabinet Arthasena Periode 2026/2027.
        </p>
      </div>
    </Container>
  </section>

  <!-- Section Pembina -->
  <Section bg="white" class="py-10 sm:py-12 lg:py-16">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 class="type-heading-secondary">
          <span class="text-navy-900">Pembina</span> <span class="text-slate-700">HIMASTI</span>
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-700 leading-relaxed">
          Dosen pembina yang mengarahkan dan membimbing jalannya roda organisasi.
        </p>
      </div>

      <!-- Pembina Card -->
      <div class="max-w-sm mx-auto">
        <div class="rounded-[22px] border border-mist-100 bg-white p-6 sm:p-7 text-center shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-slate-400">
          <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-mist-100 flex items-center justify-center text-slate-700">
            <svg
              class="w-10 h-10"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
              />
            </svg>
          </div>
          <h3 class="font-heading text-lg sm:text-xl font-medium text-navy-900">
            Neneng Rachmalia Feta, M.Kom.
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Dosen Pembina HIMASTI Periode 2026/2027
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Section Pengurus Inti: Accordion Image Cards -->
  <Section bg="white" class="py-10 sm:py-12 lg:py-16 border-t border-mist-100">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="type-heading-secondary">
          <span class="text-navy-900">Pengurus</span> <span class="text-slate-700">Inti</span>
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-700 leading-relaxed">
          Pimpinan pusat yang mengoordinasikan seluruh pergerakan, administrasi, dan arah strategis himpunan.
        </p>
      </div>

      {pengurusInti.length > 0 ? (
        <div class="group flex max-md:flex-col justify-center gap-2 sm:gap-3 w-full mx-auto">
          {pengurusInti.map((p) => (
            <article
              class="group/article relative w-full rounded-2xl overflow-hidden
                md:not-[&:hover]:group-hover:w-[20%]
                md:[&:not(:focus-within):not(:hover)]:group-focus-within:w-[20%]
                transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.15)]
                before:absolute before:inset-x-0 before:bottom-0 before:h-1/2
                before:bg-gradient-to-t before:from-navy-900/90 before:via-navy-900/40 before:to-transparent
                before:transition-opacity md:before:opacity-0 md:hover:before:opacity-100 focus-within:before:opacity-100
                before:pointer-events-none
                after:opacity-0 md:not-[&:hover]:group-hover:after:opacity-100
                md:[&:not(:focus-within):not(:hover)]:group-focus-within:after:opacity-100
                after:absolute after:inset-0 after:bg-white/20 after:backdrop-blur-[2px]
                after:rounded-2xl after:transition-all after:pointer-events-none"
              tabindex="0"
            >
              {p.data.foto ? (
                <Image
                  src={p.data.foto}
                  alt={`Foto ${p.data.nama}`}
                  width={480}
                  height={640}
                  class="object-cover h-72 md:h-[420px] w-full"
                  loading="lazy"
                />
              ) : (
                <div class="surface-ink flex h-72 md:h-[420px] w-full items-center justify-center text-white font-mono text-3xl font-medium">
                  {monogram(p.data.nama)}
                </div>
              )}
              <div class="absolute inset-0 text-white z-10 p-4 flex flex-col justify-end">
                <h3 class="font-heading text-base sm:text-lg font-medium leading-snug
                  md:opacity-0 group-hover/article:opacity-100
                  md:translate-y-2 md:group-hover/article:translate-y-0
                  transition duration-200">{p.data.nama}</h3>
                <p class="text-xs sm:text-sm text-white/80 mt-0.5
                  md:opacity-0 group-hover/article:opacity-100
                  md:translate-y-2 md:group-hover/article:translate-y-0
                  transition duration-200 delay-75">{p.data.jabatan}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-center text-slate-700 italic">
          Data pengurus inti belum tersedia.
        </p>
      )}
    </Container>
  </Section>

  <!-- Section Kepala Divisi: Accordion Image Cards with Links -->
  <Section bg="white" class="py-10 sm:py-12 lg:py-16 border-t border-mist-100">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="type-heading-secondary">
          <span class="text-navy-900">Kepala</span> <span class="text-slate-700">Divisi</span>
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-700 leading-relaxed">
          Pimpinan divisi pelaksana program kerja. Klik divisi untuk melihat dokumentasi foto bersama dan penjelasan lengkap.
        </p>
      </div>

      <div class="group flex max-md:flex-col justify-center gap-2 sm:gap-3 w-full mx-auto">
        {kepalaDivisiList.map((k) => (
          <a
            href={`/divisi/${k.slug}`}
            class="group/article relative w-full rounded-2xl overflow-hidden
              md:not-[&:hover]:group-hover:w-[20%]
              md:[&:not(:focus-within):not(:hover)]:group-focus-within:w-[20%]
              transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.15)]
              before:absolute before:inset-x-0 before:bottom-0 before:h-1/2
              before:bg-gradient-to-t before:from-navy-900/90 before:via-navy-900/40 before:to-transparent
              before:transition-opacity md:before:opacity-0 md:hover:before:opacity-100 focus-within:before:opacity-100
              before:pointer-events-none
              after:opacity-0 md:not-[&:hover]:group-hover:after:opacity-100
              md:[&:not(:focus-within):not(:hover)]:group-focus-within:after:opacity-100
              after:absolute after:inset-0 after:bg-white/20 after:backdrop-blur-[2px]
              after:rounded-2xl after:transition-all after:pointer-events-none
              focus-visible:outline-2 focus-visible:outline-navy-900"
          >
            {k.foto ? (
              <Image
                src={k.foto}
                alt={`Foto ${k.nama}`}
                width={480}
                height={600}
                class="object-cover h-72 md:h-[420px] w-full"
                loading="lazy"
              />
            ) : (
              <div class="surface-ink flex h-72 md:h-[420px] w-full items-center justify-center text-white font-mono text-3xl font-medium">
                {monogram(k.nama)}
              </div>
            )}
            <div class="absolute inset-0 text-white z-10 p-4 flex flex-col justify-end">
              <span class="text-[11px] font-mono tracking-wider uppercase opacity-80 mb-0.5
                md:opacity-0 group-hover/article:opacity-100
                md:translate-y-2 md:group-hover/article:translate-y-0
                transition duration-200">{k.divisiNama}</span>
              <h3 class="font-heading text-base sm:text-lg font-medium leading-snug
                md:opacity-0 group-hover/article:opacity-100
                md:translate-y-2 md:group-hover/article:translate-y-0
                transition duration-200 delay-75">{k.nama}</h3>
              <p class="text-xs text-white/80 mt-0.5
                md:opacity-0 group-hover/article:opacity-100
                md:translate-y-2 md:group-hover/article:translate-y-0
                transition duration-200 delay-100">{k.jabatan}</p>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
