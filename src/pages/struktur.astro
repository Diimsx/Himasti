---
/**
 * Struktur Organisasi — Struktur kepengurusan HIMASTI Periode 2026/2027.
 * Menampilkan Pembina, Pengurus Inti (layout grid rapih & proporsional),
 * dan 4 Kepala Divisi berjajar menyamping yang menautkan ke halaman detail divisi.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';

const allPengurus = await getCollection('pengurus');
const allDivisi = await getCollection('divisi');

// Urutkan divisi sesuai urutan
const sortedDivisi = allDivisi.sort((a, b) => (a.data.urutan ?? 0) - (b.data.urutan ?? 0));

// Pengurus inti: pengurus tanpa divisi
const pengurusInti = allPengurus
  .filter((p) => !p.data.divisi)
  .sort((a, b) => a.data.urutan - b.data.urutan);

// Kepala per divisi
const kepalaDivisiList = sortedDivisi.map((div) => {
  const kepalaPengurus = allPengurus.find(
    (p) =>
      p.data.divisi?.toLowerCase() === div.data.nama.toLowerCase() &&
      p.data.jabatan.toLowerCase().includes('kepala')
  ) || allPengurus.find(
    (p) => p.data.divisi?.toLowerCase() === div.data.nama.toLowerCase()
  );

  return {
    divisiNama: div.data.nama,
    slug: div.data.slug,
    ringkasan: div.data.ringkasan,
    nama: kepalaPengurus?.data.nama ?? div.data.kepala,
    jabatan: kepalaPengurus?.data.jabatan ?? 'Kepala Divisi',
    foto: kepalaPengurus?.data.foto,
    angkatan: kepalaPengurus?.data.angkatan,
  };
});

const monogram = (nama: string) =>
  nama
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
---

<BaseLayout
  title="Struktur Organisasi"
  description="Susunan pengurus dan struktur organisasi Himpunan Mahasiswa Sistem & Teknologi Informasi (HIMASTI) Cyber University Periode 2026/2027."
>
  <!-- Page Hero Header -->
  <section class="pt-24 sm:pt-28 lg:pt-32 pb-8 sm:pb-10 lg:pb-12 bg-white border-b border-mist-100">
    <Container>
      <div class="max-w-3xl">
        <h1 class="type-heading-primary text-navy-900">Struktur Organisasi</h1>
        <p class="mt-3 type-body-lead text-slate-700 max-w-2xl leading-relaxed">
          Struktur kepengurusan Himpunan Mahasiswa Sistem &amp; Teknologi Informasi (HIMASTI) Cyber University Kabinet Arthasena Periode 2026/2027.
        </p>
      </div>
    </Container>
  </section>

  <!-- Section Pembina -->
  <Section bg="white" class="py-10 sm:py-12 lg:py-16">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 class="type-heading-secondary">
          <span class="text-navy-900">Pembina</span> <span class="text-slate-700">HIMASTI</span>
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-700 leading-relaxed">
          Dosen pembina yang mengarahkan dan membimbing jalannya roda organisasi.
        </p>
      </div>

      <!-- Pembina Card -->
      <div class="max-w-sm mx-auto">
        <div class="rounded-[22px] border border-mist-100 bg-white p-6 sm:p-7 text-center shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-slate-400">
          <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-mist-100 flex items-center justify-center text-slate-700">
            <svg
              class="w-10 h-10"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
              />
            </svg>
          </div>
          <h3 class="font-heading text-lg sm:text-xl font-medium text-navy-900">
            Neneng Rachmalia Feta, M.Kom.
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Dosen Pembina HIMASTI Periode 2026/2027
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Section Pengurus Inti: Grid Rapi, Proporsional, & Mobile Responsif -->
  <Section bg="white" class="py-10 sm:py-12 lg:py-16 border-t border-mist-100">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="type-heading-secondary">
          <span class="text-navy-900">Pengurus</span> <span class="text-slate-700">Inti</span>
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-700 leading-relaxed">
          Pimpinan pusat yang mengoordinasikan seluruh pergerakan, administrasi, dan arah strategis himpunan.
        </p>
      </div>

      {pengurusInti.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6 max-w-5xl mx-auto">
          {pengurusInti.map((p) => (
            <div class="group relative overflow-hidden rounded-[20px] bg-mist-100 border border-mist-100 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md aspect-[3/4] flex flex-col justify-end">
              {p.data.foto ? (
                <Image
                  src={p.data.foto}
                  alt={`Foto ${p.data.nama}`}
                  width={480}
                  height={640}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="surface-ink absolute inset-0 flex h-full w-full items-center justify-center text-white font-mono text-3xl font-medium">
                  {monogram(p.data.nama)}
                </div>
              )}
              <!-- Gradient overlay halus agar teks terbaca jelas -->
              <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-navy-900/90 via-navy-900/50 to-transparent pointer-events-none"></div>
              <div class="relative z-10 p-5 text-white">
                <h3 class="font-heading text-base sm:text-lg font-medium leading-snug">{p.data.nama}</h3>
                <p class="text-xs sm:text-sm text-mist-100 mt-1 font-medium">{p.data.jabatan}</p>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-center text-slate-700 italic">
          Data pengurus inti belum tersedia.
        </p>
      )}
    </Container>
  </Section>

  <!-- Section Kepala Divisi: Jejerin Menyamping, Layout Rapih, Klik menuju Detail Divisi -->
  <Section bg="white" class="py-10 sm:py-12 lg:py-18 border-t border-mist-100">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="type-heading-secondary">
          <span class="text-navy-900">Kepala</span> <span class="text-slate-700">Divisi</span>
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-700 leading-relaxed">
          Pimpinan divisi pelaksana program kerja. Klik divisi untuk melihat dokumentasi foto bersama dan penjelasan lengkap.
        </p>
      </div>

      <!-- Grid 4 Kolom Menyamping Responsif -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
        {kepalaDivisiList.map((k) => (
          <a
            href={`/divisi/${k.slug}`}
            class="group flex flex-col justify-between rounded-[20px] border border-mist-100 bg-white p-4 sm:p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-slate-400 focus-visible:outline-2 focus-visible:outline-navy-900"
          >
            <div>
              <!-- Foto Kepala Divisi -->
              <div class="relative aspect-[4/5] rounded-[16px] overflow-hidden bg-mist-100 mb-3.5">
                {k.foto ? (
                  <Image
                    src={k.foto}
                    alt={`Foto ${k.nama}`}
                    width={480}
                    height={600}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="surface-ink flex h-full w-full items-center justify-center text-white font-mono text-3xl font-medium">
                    {monogram(k.nama)}
                  </div>
                )}
                <!-- Gradient overlay halus di bawah foto -->
                <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-navy-900/60 to-transparent pointer-events-none"></div>
                <div class="absolute bottom-2.5 left-3 right-3 text-white">
                  <span class="text-[11px] font-mono tracking-wider uppercase opacity-90 drop-shadow-sm">
                    {k.jabatan}
                  </span>
                </div>
              </div>

              <!-- Nama Divisi sebagai label bersih -->
              <p class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-1">
                {k.divisiNama}
              </p>

              <!-- Nama Kepala Divisi -->
              <h3 class="font-heading text-base sm:text-lg font-medium text-navy-900 group-hover:text-slate-800 transition-colors">
                {k.nama}
              </h3>

              {k.angkatan && (
                <p class="text-xs font-mono text-slate-500 mt-0.5">
                  Angkatan {k.angkatan}
                </p>
              )}
            </div>

            <!-- Bottom CTA Link -->
            <div class="mt-4 pt-3 border-t border-mist-100 flex items-center justify-between text-xs font-medium text-navy-900 group-hover:text-navy-800">
              <span>Detail Divisi</span>
              <svg
                class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
