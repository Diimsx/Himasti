---
/**
 * Detail Divisi — Menampilkan foto bersama per divisi, penjelasan divisi,
 * tugas pokok & fungsi (tupoksi), dan daftar anggota.
 */
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';

import kreasiInovasiImg from '../../assets/divisi/kreasi-inovasi.jpg';
import humasImg from '../../assets/divisi/humas.jpg';
import sarprasImg from '../../assets/divisi/sarpras.jpg';
import medinfoImg from '../../assets/divisi/medinfo.jpg';

const divisionPhotos: Record<string, ImageMetadata> = {
  'kreasi-inovasi': kreasiInovasiImg,
  'humas': humasImg,
  'sarpras': sarprasImg,
  'medinfo': medinfoImg,
};

export const getStaticPaths = (async () => {
  const allDivisi = await getCollection('divisi');

  return allDivisi.map((divisi) => ({
    params: { slug: divisi.data.slug },
    props: { divisi },
  }));
}) satisfies GetStaticPaths;

const { divisi } = Astro.props;
const { Content } = await render(divisi);
const groupPhoto = divisionPhotos[divisi.data.slug];

const monogram = (nama: string) =>
  nama
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
---

<BaseLayout
  title={`Divisi ${divisi.data.nama}`}
  description={divisi.data.ringkasan ?? `Profil lengkap Divisi ${divisi.data.nama} HIMASTI Cyber University.`}
>
  <!-- Page Header -->
  <section class="pt-24 sm:pt-28 lg:pt-32 pb-8 sm:pb-10 lg:pb-12 bg-white border-b border-mist-100">
    <Container>
      <!-- Back to Struktur -->
      <a
        href="/struktur"
        class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-slate-500 hover:text-navy-900 transition-colors mb-5 focus-visible:outline-2 focus-visible:outline-navy-900"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Kembali ke Struktur Organisasi
      </a>

      <h1 class="type-heading-primary text-navy-900 mb-3 max-w-4xl">
        Divisi {divisi.data.nama}
      </h1>

      {divisi.data.ringkasan && (
        <p class="type-body-lead text-slate-700 max-w-2xl">
          {divisi.data.ringkasan}
        </p>
      )}
    </Container>
  </section>

  <!-- Row 1: Foto Divisi (kiri) + Tentang Divisi (kanan) -->
  <Section bg="white" class="py-8 sm:py-10 lg:py-14">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Kolom Kiri: Foto Bersama (4:5 aspect) -->
        <div class="lg:col-span-5">
          <div class="rounded-[20px] overflow-hidden border border-mist-100 bg-mist-50 shadow-sm">
            <div class="relative w-full aspect-[4/5] overflow-hidden bg-navy-900/5">
              {groupPhoto ? (
                <Image
                  src={groupPhoto}
                  alt={`Foto Bersama Divisi ${divisi.data.nama}`}
                  width={800}
                  height={1000}
                  class="w-full h-full object-cover"
                  loading="eager"
                />
              ) : (
                <div class="flex flex-col items-center justify-center h-full p-12 text-slate-500 text-center">
                  <svg class="w-16 h-16 mb-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                  </svg>
                  <p class="font-medium">Foto bersama Divisi {divisi.data.nama}</p>
                </div>
              )}
            </div>
            <div class="p-3 sm:p-4 bg-white border-t border-mist-100 flex flex-wrap items-center justify-between gap-2 text-xs sm:text-sm">
              <div class="flex items-center gap-2 text-slate-700">
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="font-medium">Divisi {divisi.data.nama}</span>
              </div>
              <span class="font-mono text-slate-500">Kabinet Arthasena 2026/2027</span>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Tentang Divisi -->
        <div class="lg:col-span-7 space-y-5">
          <h2 class="type-heading-secondary text-navy-900">
            Tentang Divisi {divisi.data.nama}
          </h2>

          <div class="prose max-w-none text-slate-700 text-sm sm:text-base leading-relaxed space-y-4">
            <Content />
          </div>

          <!-- Highlight Kepala Divisi -->
          <div class="mt-6 pt-5 border-t border-mist-100">
            <p class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-2">Kepala Divisi</p>
            <div class="inline-flex items-center gap-3.5 p-3.5 rounded-[16px] bg-mist-50 border border-mist-100">
              <div class="w-11 h-11 rounded-full bg-navy-900 text-white font-heading font-medium flex items-center justify-center shrink-0 text-sm">
                {monogram(divisi.data.kepala)}
              </div>
              <div>
                <p class="font-heading font-medium text-navy-900 text-sm sm:text-base">{divisi.data.kepala}</p>
                <p class="text-xs text-slate-500">Kepala Divisi {divisi.data.nama}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Row 2: Tugas Pokok & Fungsi -->
  <Section bg="white" class="py-10 sm:py-12 lg:py-16 border-t border-mist-100">
    <Container>
      <h2 class="type-heading-secondary text-navy-900 mb-6">
        Tugas Pokok &amp; Fungsi
      </h2>

      {divisi.data.tugas && divisi.data.tugas.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
          {divisi.data.tugas.map((tugasItem, idx) => (
            <div class="rounded-[18px] border border-mist-100 bg-mist-50 p-4 sm:p-5">
              <div class="flex items-start gap-3">
                <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-navy-900 text-white text-xs font-mono font-medium">
                  {idx + 1}
                </span>
                <p class="text-sm sm:text-base text-slate-700 leading-relaxed">{tugasItem}</p>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-sm text-slate-500 italic">
          Rincian tugas pokok divisi akan diperbarui secara berkala.
        </p>
      )}

      <!-- Link Kembali ke Struktur Organisasi -->
      <div class="mt-10 pt-6 border-t border-mist-100 flex items-center justify-between">
        <a
          href="/struktur"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-navy-900 hover:text-navy-800 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Kembali ke Struktur Organisasi
        </a>
      </div>
    </Container>
  </Section>
</BaseLayout>
