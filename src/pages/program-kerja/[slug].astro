---
/**
 * Detail Program Kerja — Halaman rincian proker individual.
 * Menggunakan getStaticPaths untuk menghasilkan rute dinamis secara statis.
 */
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Badge from '../../components/ui/Badge.astro';
import Prose from '../../components/ui/Prose.astro';

export const getStaticPaths = (async () => {
  const prokerEntries = await getCollection('proker');
  return prokerEntries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const statusLabel: Record<string, string> = {
  'akan-datang': 'Akan Datang',
  'berlangsung': 'Berlangsung',
  'selesai': 'Selesai',
};

const statusVariant: Record<string, 'warning' | 'info' | 'success'> = {
  'akan-datang': 'warning',
  'berlangsung': 'info',
  'selesai': 'success',
};
---

<BaseLayout
  title={`${entry.data.judul} — Program Kerja HIMASTI`}
  description={entry.data.ringkasan}
>
  <!-- Hero-like Header -->
  <section class="bg-navy-900 text-white py-12 lg:py-16 border-b border-navy-800">
    <Container>
      <!-- Back Link -->
      <a
        href="/program-kerja"
        class="inline-flex items-center gap-2 font-mono text-xs tracking-wider uppercase text-gray-300 hover:text-white transition-colors mb-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-dark"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Kembali ke Program Kerja
      </a>

      <!-- Category and Status Badge -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="font-mono text-xs tracking-[0.08em] uppercase font-medium text-accent-dark">
          // {entry.data.kategori}
        </span>
        <Badge variant={statusVariant[entry.data.status]}>
          {statusLabel[entry.data.status]}
        </Badge>
      </div>

      <!-- Title -->
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-4">
        {entry.data.judul}
      </h1>

      <!-- Summary -->
      <p class="text-base sm:text-lg text-gray-300 max-w-2xl leading-relaxed">
        {entry.data.ringkasan}
      </p>
    </Container>
  </section>

  <!-- Content & Metadata Section (white) -->
  <Section bg="white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-start">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <Prose>
            <Content />
          </Prose>
        </div>

        <!-- Sidebar Metadata -->
        <aside class="w-full">
          <div class="rounded-xl border border-gray-300 bg-white p-6 sticky top-24">
            <p class="font-mono text-xs tracking-[0.08em] uppercase font-medium text-accent-light mb-4">
              // informasi proker
            </p>

            <dl class="space-y-4 text-sm divide-y divide-gray-300/60">
              <div class="pt-2">
                <dt class="font-mono text-xs uppercase text-slate-500">Status</dt>
                <dd class="mt-1">
                  <Badge variant={statusVariant[entry.data.status]}>
                    {statusLabel[entry.data.status]}
                  </Badge>
                </dd>
              </div>

              <div class="pt-4">
                <dt class="font-mono text-xs uppercase text-slate-500">Kategori</dt>
                <dd class="mt-1 font-medium text-navy-900 capitalize">
                  {entry.data.kategori}
                </dd>
              </div>

              <div class="pt-4">
                <dt class="font-mono text-xs uppercase text-slate-500">Waktu</dt>
                <dd class="mt-1 font-mono text-navy-900">
                  {entry.data.waktu}
                </dd>
              </div>

              {entry.data.sasaran && (
                <div class="pt-4">
                  <dt class="font-mono text-xs uppercase text-slate-500">Sasaran</dt>
                  <dd class="mt-1 text-slate-700 leading-relaxed">
                    {entry.data.sasaran}
                  </dd>
                </div>
              )}

              {entry.data.tujuan && (
                <div class="pt-4">
                  <dt class="font-mono text-xs uppercase text-slate-500">Tujuan</dt>
                  <dd class="mt-1 text-slate-700 leading-relaxed">
                    {entry.data.tujuan}
                  </dd>
                </div>
              )}

              <div class="pt-4">
                <dt class="font-mono text-xs uppercase text-slate-500">Periode</dt>
                <dd class="mt-1 text-slate-700 font-mono">
                  {entry.data.periode}
                </dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </Container>
  </Section>
</BaseLayout>
