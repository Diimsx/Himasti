---
/**
 * Program Kerja — Daftar seluruh program kerja HIMASTI Periode 2026/2027.
 * Dilengkapi filter interaktif berbasis kategori.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import ProkerCard from '../../components/ui/ProkerCard.astro';

const allProker = await getCollection('proker');
const prokerList = allProker.sort((a, b) =>
  a.data.judul.localeCompare(b.data.judul)
);

const filterOptions = [
  { label: 'Semua Program', value: 'all' },
  { label: 'Kunjungan', value: 'kunjungan' },
  { label: 'Pelatihan', value: 'pelatihan' },
  { label: 'Kebersamaan', value: 'kebersamaan' },
  { label: 'Seminar', value: 'seminar' },
];
---

<BaseLayout
  title="Program Kerja"
  description="Daftar program kerja Himpunan Mahasiswa Sistem & Teknologi Informasi (HIMASTI) Cyber University Periode 2026/2027."
>
  <!-- Page Hero Header -->
  <section class="pt-32 lg:pt-40 pb-16 lg:pb-20 bg-white border-b border-mist-100">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-flex items-center rounded-full border border-gray-300 text-slate-700 px-3 py-1 text-xs font-medium tracking-[0.02em] mb-4">
          Inisiatif Strategis 2026/2027
        </span>
        <h1 class="type-heading-primary text-navy-900">Program Kerja</h1>
        <p class="mt-4 type-body-lead text-slate-700 max-w-2xl leading-relaxed">
          Rangkaian inisiatif dan kegiatan strategis HIMASTI Cyber University untuk mengakselerasi wawasan industri, kompetensi teknis, serta jejaring kolaborasi mahasiswa.
        </p>
      </div>
    </Container>
  </section>

  <!-- Section Program Kerja -->
  <Section bg="white" class="py-16 lg:py-24">
    <Container>
      <!-- Filter Bar -->
      <div class="mb-10 sm:mb-12">
        <div class="flex flex-wrap items-center gap-2 p-1.5 rounded-full bg-mist-50 border border-mist-100 max-w-fit" role="group" aria-label="Filter kategori program kerja">
          {filterOptions.map((opt, idx) => (
            <button
              type="button"
              data-filter={opt.value}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class:list={[
                'filter-btn inline-flex items-center justify-center min-h-[40px] px-5 py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all duration-150 cursor-pointer focus-visible:outline-2 focus-visible:outline-navy-900',
                idx === 0
                  ? 'bg-navy-900 text-white shadow-sm font-medium'
                  : 'text-slate-700 hover:text-navy-900 hover:bg-white',
              ]}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Proker Grid -->
      {prokerList.length > 0 ? (
        <div id="proker-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {prokerList.map((proker) => (
            <div
              class="proker-item transition-all duration-150"
              data-kategori={proker.data.kategori}
            >
              <ProkerCard
                judul={proker.data.judul}
                slug={proker.data.slug}
                ringkasan={proker.data.ringkasan}
                waktu={proker.data.waktu}
                kategori={proker.data.kategori}
                status={proker.data.status}
              />
            </div>
          ))}
        </div>
      ) : (
        <p class="text-center text-slate-700 italic py-12">
          Belum ada program kerja yang terdaftar.
        </p>
      )}

      <!-- Empty State Filter Notice -->
      <div
        id="empty-filter-message"
        class="hidden text-center py-16 px-4 rounded-[20px] border border-mist-100 bg-mist-50 max-w-md mx-auto"
      >
        <p class="text-slate-700 font-medium">Tidak ada program kerja dalam kategori ini.</p>
        <p class="text-xs text-slate-500 mt-1">Silakan pilih kategori program lainnya di atas.</p>
      </div>
    </Container>
  </Section>
</BaseLayout>

<script>
  function setupProkerFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.proker-item');
    const emptyMsg = document.getElementById('empty-filter-message');

    if (!buttons.length || !items.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update button states
        buttons.forEach((b) => {
          const isActive = b === btn;
          b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          if (isActive) {
            b.classList.add('bg-navy-900', 'text-white', 'shadow-sm');
            b.classList.remove('text-slate-700', 'hover:bg-white');
          } else {
            b.classList.remove('bg-navy-900', 'text-white', 'shadow-sm');
            b.classList.add('text-slate-700', 'hover:bg-white');
          }
        });

        // Filter cards
        let visibleCount = 0;
        items.forEach((item) => {
          const itemCat = item.getAttribute('data-kategori');
          if (filter === 'all' || itemCat === filter) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        // Toggle empty message
        if (emptyMsg) {
          if (visibleCount === 0) {
            emptyMsg.classList.remove('hidden');
          } else {
            emptyMsg.classList.add('hidden');
          }
        }
      });
    });
  }

  // Run on initial load
  setupProkerFilter();
  document.addEventListener('astro:page-load', setupProkerFilter);
</script>
