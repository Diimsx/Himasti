---
/**
 * Beranda — HIMASTI Cyber University Homepage
 * Assembles all homepage sections in prescribed order:
 * Hero -> StatsStrip -> AboutPreview -> DivisiPreview -> Pulau gelap Pernyataan -> ProkerPreview -> Pulau gelap Timeline -> CTABand
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import StatsStrip from '../components/sections/StatsStrip.astro';
import AboutPreview from '../components/sections/AboutPreview.astro';
import DivisiPreview from '../components/sections/DivisiPreview.astro';
import ProkerPreview from '../components/sections/ProkerPreview.astro';
import Timeline from '../components/sections/Timeline.astro';
import CTABand from '../components/sections/CTABand.astro';
import Container from '../components/ui/Container.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<BaseLayout
  title="Beranda"
  description="Website resmi Himpunan Mahasiswa Sistem & Teknologi Informasi (HIMASTI) Cyber University."
>
  <Hero />
  <StatsStrip />
  <AboutPreview />
  <DivisiPreview />

  <!-- Pulau gelap Pernyataan (NEW) -->
  <section class="px-2 lg:px-3 py-4">
    <div class="surface-ink rounded-[32px] lg:rounded-[40px] shadow-xl relative overflow-hidden py-20 lg:py-32">
      <div class="absolute inset-0 bg-dots-dark pointer-events-none" aria-hidden="true"></div>
      <div class="absolute inset-0 ink-glow pointer-events-none" aria-hidden="true"></div>
      <Container>
        <div class="relative z-10 text-center max-w-3xl mx-auto">
          <span class="inline-flex items-center rounded-full border border-gray-300 text-gray-300 px-3 py-1 text-xs font-medium tracking-[0.02em] mb-6">Tentang Kami</span>
          <p class="font-heading text-2xl sm:text-3xl lg:text-[40px] font-medium leading-[1.3] tracking-[-0.01em] text-white">Wadah aspirasi, kolaborasi, dan akselerasi potensi bagi seluruh mahasiswa Sistem &amp; Teknologi Informasi Cyber University.</p>
        </div>
      </Container>
    </div>
  </section>

  <ProkerPreview />

  <!-- Pulau gelap Timeline -->
  <section class="px-2 lg:px-3 py-4">
    <div class="surface-ink rounded-[32px] lg:rounded-[40px] shadow-xl relative overflow-hidden py-20 lg:py-32">
      <div class="absolute inset-0 bg-dots-dark pointer-events-none" aria-hidden="true"></div>
      <Container>
        <SectionHeader
          eyebrow="timeline"
          title="Roadmap 2026/2027"
          description="Jadwal pelaksanaan program kerja HIMASTI sepanjang periode kepengurusan 2026/2027."
          dark={true}
        />
        <Timeline />
      </Container>
    </div>
  </section>

  <CTABand />
</BaseLayout>
