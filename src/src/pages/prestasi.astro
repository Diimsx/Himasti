---
/**
 * Prestasi — Halaman dokumentasi pencapaian dan prestasi mahasiswa HIMASTI.
 * Menampilkan daftar penghargaan akademik dan non-akademik di berbagai tingkatan.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Badge from '../components/ui/Badge.astro';

const allPrestasi = await getCollection('prestasi');
const prestasiList = allPrestasi.sort((a, b) => b.data.tahun - a.data.tahun);
---

<BaseLayout
  title="Prestasi"
  description="Daftar pencapaian dan kebanggaan mahasiswa Sistem & Teknologi Informasi (HIMASTI) Cyber University di berbagai ajang kompetisi."
>
  <!-- Page Hero Header -->
  <section class="pt-32 lg:pt-40 pb-16 lg:pb-20 bg-white">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-flex items-center rounded-full border border-gray-300 text-slate-700 px-3 py-1 text-xs font-medium tracking-[0.02em] mb-6">Prestasi</span>
        <h1 class="type-heading-primary">Prestasi Mahasiswa</h1>
        <p class="mt-4 text-base sm:text-lg text-slate-500 max-w-2xl leading-relaxed">
          Pencapaian dan kebanggaan mahasiswa Sistem &amp; Teknologi Informasi yang mengukir prestasi gemilang di berbagai ajang kompetisi.
        </p>
      </div>
    </Container>
  </section>

  <!-- Section Prestasi (white) -->
  <Section bg="white" class="py-20 lg:py-32">
    <Container>
      {prestasiList.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {prestasiList.map((item) => (
            <div class="rounded-[20px] border border-mist-100 bg-white p-6 flex flex-col justify-between shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:shadow-md hover:border-slate-500">
              <div>
                {item.data.foto && (
                  <div class="aspect-video mb-5 rounded-[14px] overflow-hidden border border-mist-100">
                    <Image
                      src={item.data.foto}
                      alt={item.data.nama}
                      width={640}
                      height={360}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                )}

                <div class="flex items-center justify-between gap-3 mb-4">
                  <div class="w-10 h-10 rounded-lg bg-mist-100 flex items-center justify-center text-slate-700 shrink-0">
                    <!-- Trophy Icon -->
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                      />
                    </svg>
                  </div>
                  <Badge variant="default">
                    {item.data.tingkat}
                  </Badge>
                </div>

                <h3 class="font-heading text-lg font-medium text-navy-900 mb-2">
                  {item.data.nama}
                </h3>
                <p class="text-sm text-slate-700 leading-relaxed">
                  {item.data.penerima}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-mist-100 flex items-center justify-between text-xs font-mono text-slate-500">
                <span class="uppercase">Tahun</span>
                <span class="font-semibold text-navy-900">{item.data.tahun}</span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="py-16 sm:py-24 text-center max-w-md mx-auto">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-mist-100 flex items-center justify-center text-slate-500">
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
              />
            </svg>
          </div>
          <h2 class="font-heading text-xl font-medium text-navy-900 mb-2">
            Prestasi HIMASTI
          </h2>
          <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
            Belum ada data prestasi. Pencapaian HIMASTI akan ditampilkan di sini.
          </p>
        </div>
      )}
    </Container>
  </Section>
</BaseLayout>
