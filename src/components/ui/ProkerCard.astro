---
/**
 * ProkerCard — Card for program kerja with status badge.
 * Whole card is clickable. Status badge uses text, not just color (a11y).
 */
import Badge from './Badge.astro';

interface Props {
  judul: string;
  slug: string;
  ringkasan: string;
  waktu: string;
  kategori: string;
  status: 'akan-datang' | 'berlangsung' | 'selesai';
  class?: string;
}

const { judul, slug, ringkasan, waktu, kategori, status, class: className = '' } = Astro.props;

const statusLabel: Record<string, string> = {
  'akan-datang': 'Akan Datang',
  'berlangsung': 'Berlangsung',
  'selesai': 'Selesai',
};

const statusVariant: Record<string, 'warning' | 'info' | 'success'> = {
  'akan-datang': 'warning',
  'berlangsung': 'info',
  'selesai': 'success',
};
---

<a
  href={`/program-kerja/${slug}`}
  class:list={[
    'group block rounded-xl border border-gray-300 bg-white p-6 transition-all duration-150',
    'hover:-translate-y-0.5 hover:shadow-md hover:border-accent-light',
    className,
  ]}
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <p class="font-mono text-xs tracking-[0.08em] uppercase font-medium text-accent-light">
      // {kategori}
    </p>
    <Badge variant={statusVariant[status]}>
      {statusLabel[status]}
    </Badge>
  </div>
  <h3 class="font-heading text-xl font-bold text-navy-900 mb-2">
    {judul}
  </h3>
  <p class="text-sm text-slate-700 leading-relaxed mb-4 line-clamp-2">
    {ringkasan}
  </p>
  <p class="text-xs text-slate-500 font-mono">
    {waktu}
  </p>
</a>
