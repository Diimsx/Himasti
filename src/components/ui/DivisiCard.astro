---
/**
 * DivisiCard — Card displaying a division's info.
 * Radius 20px, border mist-100, hover lift effect (design.md § 4, § 6).
 */
interface Props {
  nama: string;
  slug: string;
  ringkasan?: string;
  kepala: string;
  /** Whether on dark background */
  dark?: boolean;
  class?: string;
}

const { nama, slug, ringkasan, kepala, dark = false, class: className = '' } = Astro.props;

const cardClasses = dark
  ? 'surface-glass rounded-[20px] text-white hover:-translate-y-[2px] hover:shadow-md'
  : 'bg-white border border-mist-100 rounded-[20px] shadow-sm hover:shadow-md hover:border-slate-500 hover:-translate-y-[2px]';

const titleColor = dark ? 'text-white' : 'text-navy-900';
const textColor = dark ? 'text-gray-300' : 'text-slate-700';
const metaColor = dark ? 'text-gray-300' : 'text-slate-500';
---

<a
  href={`/divisi#${slug}`}
  class:list={[
    'group block p-6 transition-all duration-150',
    cardClasses,
    className,
  ]}
>
  <span class:list={[
    'inline-flex items-center rounded-full border border-gray-300 px-2.5 py-0.5 text-xs font-medium tracking-[0.02em] mb-3',
    metaColor,
  ]}>
    Divisi
  </span>
  <h3 class:list={['font-heading text-xl font-medium mb-2', titleColor]}>
    {nama}
  </h3>
  {ringkasan && (
    <p class:list={['text-sm leading-relaxed mb-4 line-clamp-3', textColor]}>
      {ringkasan}
    </p>
  )}
  <p class:list={['text-sm', textColor]}>
    <span class="font-medium">Kepala:</span> {kepala}
  </p>
</a>
