---
/**
 * InfiniteSlider — Baris logo/konten yang bergulir tanpa henti (marquee), tanpa JavaScript dan tanpa library.
 * Pola sama dengan marquee wordmark footer (design.md § 8.5): track selebar `max-content`, berisi dua
 * "setengah" identik, lalu digeser `translateX(-50%)` sehingga loop mulus.
 *
 * Aksesibilitas: hanya salinan pertama yang dibaca pembaca layar; salinan lain `aria-hidden` + `inert`.
 * Gerak: hanya aktif bila pengguna tidak memilih "reduced motion". Jika dimatikan, yang tampil adalah
 * satu baris statis yang rata tengah dan boleh membungkus ke baris berikutnya.
 */
interface Props {
  /** Jarak antar item (px) */
  gap?: number;
  /** Durasi satu putaran penuh (detik); makin besar makin pelan */
  duration?: number;
  /** Arah putar dibalik (bergulir ke kanan) */
  reverse?: boolean;
  /** Berapa kali isi slot diulang dalam satu "setengah". Naikkan bila item sedikit dan layar lebar. */
  repeat?: number;
  /** Label grup untuk pembaca layar */
  label?: string;
  class?: string;
}

const { gap = 64, duration = 40, reverse = false, repeat = 6, label, class: className = '' } = Astro.props;
const html = await Astro.slots.render('default');
---

<div
  class:list={['slider', reverse && 'is-reverse', className]}
  role="group"
  aria-label={label}
  style={`--gap:${gap}px; --dur:${duration}s;`}
>
  <div class="slider-track">
    {[0, 1].map((half) => (
      <div class="slider-half" aria-hidden={half === 1 ? 'true' : undefined} inert={half === 1}>
        {Array.from({ length: repeat }).map((_, i) => (
          <div class="slider-set" aria-hidden={half === 0 && i > 0 ? 'true' : undefined} set:html={html} />
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  /* Dasar = tanpa gerak: satu set saja, rata tengah. */
  .slider-track {
    display: flex;
    justify-content: center;
  }
  .slider-half:nth-child(2),
  .slider-set:not(:first-child) {
    display: none;
  }
  .slider-half {
    display: flex;
  }
  .slider-set {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--gap);
  }

  @media (prefers-reduced-motion: no-preference) {
    .slider {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    }
    .slider-track {
      width: max-content;
      justify-content: flex-start;
      animation: slider-scroll var(--dur) linear infinite;
    }
    .is-reverse .slider-track {
      animation-direction: reverse;
    }
    .slider:hover .slider-track {
      animation-play-state: paused;
    }
    .slider-half:nth-child(2),
    .slider-set:not(:first-child) {
      display: flex;
    }
    .slider-set {
      flex-wrap: nowrap;
      flex-shrink: 0;
      justify-content: flex-start;
      /* Tiap salinan membawa jarak kanannya sendiri, jadi -50% jatuh persis di awal setengah kedua. */
      padding-right: var(--gap);
    }
  }

  @keyframes slider-scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
