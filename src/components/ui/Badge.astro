---
/**
 * Badge — Small pill label for status or category.
 * Color is not the sole carrier of meaning (design.md § 1.3 rule 4, § 6).
 */
interface Props {
  /** Visual variant */
  variant?: 'default' | 'akan-datang' | 'berlangsung' | 'selesai';
  /** Additional CSS classes */
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variantClasses: Record<'default' | 'akan-datang' | 'berlangsung' | 'selesai', string> = {
  'default': 'bg-mist-100 text-navy-900',
  'akan-datang': 'border border-slate-700 text-slate-700',
  'berlangsung': 'bg-navy-900 text-white',
  'selesai': 'bg-mist-100 text-navy-900',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium leading-none',
    variantClasses[variant] ?? variantClasses.default,
    className,
  ]}
>
  {variant === 'berlangsung' && (
    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse" aria-hidden="true" />
  )}
  {variant === 'selesai' && (
    <svg
      class="w-3.5 h-3.5 shrink-0"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
    </svg>
  )}
  <slot />
</span>
