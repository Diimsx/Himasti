---
/**
 * Badge — Small pill label for status or category.
 * Color is not the sole carrier of meaning (design.md § 1.3 rule 4, § 6).
 */
interface Props {
  /** Visual variant */
  variant?: 'default' | 'akan-datang' | 'berlangsung' | 'selesai';
  /** Background the badge sits on (design.md § 6). Dark variants never use slate-500/700 text. */
  on?: 'light' | 'dark';
  /** Additional CSS classes */
  class?: string;
}

const { variant = 'default', on = 'light', class: className = '' } = Astro.props;

type Variant = 'default' | 'akan-datang' | 'berlangsung' | 'selesai';

const lightClasses: Record<Variant, string> = {
  'default': 'bg-mist-100 text-navy-900',
  'akan-datang': 'border border-slate-700 text-slate-700',
  'berlangsung': 'bg-navy-900 text-white',
  'selesai': 'bg-mist-100 text-navy-900',
};

// On navy: outline gray-300 / solid white + navy-900 / glass + white (contrast >= 6.78:1)
const darkClasses: Record<Variant, string> = {
  'default': 'bg-white text-navy-900',
  'akan-datang': 'border border-gray-300 text-gray-300',
  'berlangsung': 'bg-white text-navy-900',
  'selesai': 'surface-glass text-white',
};

const variantClasses = on === 'dark' ? darkClasses : lightClasses;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium leading-none',
    variantClasses[variant] ?? variantClasses.default,
    className,
  ]}
>
  {variant === 'berlangsung' && (
    <span class:list={['w-1.5 h-1.5 rounded-full motion-safe:animate-pulse', on === 'dark' ? 'bg-navy-900' : 'bg-white']} aria-hidden="true" />
  )}
  {variant === 'selesai' && (
    <svg
      class="w-3.5 h-3.5 shrink-0"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
    </svg>
  )}
  <slot />
</span>
