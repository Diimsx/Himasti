---
/**
 * Badge — Small pill label for status or category.
 * Color is not the sole carrier of meaning (design.md § 1.3 rule 4).
 */
interface Props {
  /** Visual variant */
  variant?: 'default' | 'success' | 'warning' | 'info';
  /** Additional CSS classes */
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variantClasses: Record<string, string> = {
  default: 'bg-mist-100 text-slate-700',
  success: 'bg-emerald-50 text-emerald-700 border border-emerald-200',
  warning: 'bg-amber-50 text-amber-700 border border-amber-200',
  info: 'bg-sky-50 text-accent-light border border-sky-200',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-3 py-1 text-xs font-medium leading-none',
    variantClasses[variant],
    className,
  ]}
>
  <slot />
</span>
