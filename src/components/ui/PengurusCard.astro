---
/**
 * PengurusCard — Card for organization member.
 * Photo ratio 4:5, name (H3), position, division eyebrow.
 * No NIM or personal contact displayed (PRD.md § 5.2).
 */
import { Image } from 'astro:assets';

interface Props {
  nama: string;
  jabatan: string;
  divisi?: string;
  foto?: ImageMetadata;
  class?: string;
}

const { nama, jabatan, divisi, foto, class: className = '' } = Astro.props;

// Generate monogram from name (e.g. "AD" for "Ahmad Dahlan")
const monogram = nama
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');
---

<div
  class:list={[
    'rounded-[20px] border border-mist-100 bg-white overflow-hidden text-center shadow-sm',
    className,
  ]}
>
  <div class="aspect-[4/5] rounded-t-[20px] overflow-hidden">
    {foto ? (
      <Image
        src={foto}
        alt={`Foto ${nama}`}
        width={320}
        height={400}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full surface-ink flex items-center justify-center">
        <span class="font-mono text-3xl font-medium text-white tracking-wider" aria-hidden="true">
          {monogram}
        </span>
      </div>
    )}
  </div>
  <div class="p-4">
    {divisi && (
      <span class="inline-flex items-center rounded-full border border-gray-300 text-slate-700 px-2 py-0.5 text-[11px] font-medium mb-1">
        {divisi}
      </span>
    )}
    <h3 class="font-heading text-base font-medium text-navy-900 mt-1">
      {nama}
    </h3>
    <p class="text-sm text-slate-700 mt-0.5">
      {jabatan}
    </p>
  </div>
</div>
