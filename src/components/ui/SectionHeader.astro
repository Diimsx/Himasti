---
/**
 * SectionHeader — Heading + optional description for each section (tanpa pil/eyebrow, design.md § 6).
 */
interface Props {
  /** Section heading (H2) */
  title: string;
  /** Optional description paragraph below the heading */
  description?: string;
  /** Text alignment */
  align?: 'left' | 'center';
  /** Whether the section is on a dark background */
  dark?: boolean;
}

const {
  title,
  description,
  align = 'center',
  dark = false,
} = Astro.props;

const alignClass = align === 'center' ? 'text-center' : 'text-left';
const titleColor = dark ? 'text-white' : 'text-navy-900';
const descColor = dark ? 'text-gray-300' : 'text-slate-700';
---

<div class:list={['mb-10 lg:mb-14', alignClass]}>
  <h2 class:list={[
    'type-heading-secondary',
    titleColor,
  ]}>
    {title}
  </h2>
  {description && (
    <p class:list={[
      'type-body-lead mt-4 max-w-2xl',
      align === 'center' && 'mx-auto',
      descColor,
    ]}>
      {description}
    </p>
  )}
</div>
