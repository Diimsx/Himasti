---
/**
 * BeritaCard — Card for news/article entry.
 * Shows title, date, author, summary, and optional cover image.
 */
interface Props {
  judul: string;
  slug: string;
  tanggal: Date;
  penulis: string;
  ringkasan: string;
  sampul?: ImageMetadata;
  class?: string;
}

import { Image } from 'astro:assets';

const { judul, slug, tanggal, penulis, ringkasan, sampul, class: className = '' } = Astro.props;

const formattedDate = tanggal.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<a
  href={`/berita/${slug}`}
  class:list={[
    'group block rounded-xl border border-gray-300 bg-white overflow-hidden transition-all duration-150',
    'hover:-translate-y-0.5 hover:shadow-md hover:border-accent-light',
    className,
  ]}
>
  {sampul && (
    <div class="aspect-video overflow-hidden">
      <Image
        src={sampul}
        alt={judul}
        width={640}
        height={360}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6">
    <div class="flex items-center gap-2 text-xs text-slate-500 font-mono mb-3">
      <time datetime={tanggal.toISOString()}>{formattedDate}</time>
      <span aria-hidden="true">·</span>
      <span>{penulis}</span>
    </div>
    <h3 class="font-heading text-lg font-bold text-navy-900 mb-2 group-hover:text-accent-light transition-colors">
      {judul}
    </h3>
    <p class="text-sm text-slate-700 leading-relaxed line-clamp-2">
      {ringkasan}
    </p>
  </div>
</a>
