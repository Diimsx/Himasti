---
/**
 * PengurusAccordion — Foto pengurus bergaya "image accordion": saat satu foto di-hover atau difokus,
 * foto itu melebar dan foto lainnya menyempit serta redup. CSS murni, tanpa JavaScript.
 * (Terjemahan ke Astro dari komponen React/Next "tailwind-image-accordion"; tanpa framer-motion/next/image.)
 *
 * - Desktop (≥ 768px): baris akordeon. Nama + jabatan terlihat pada semua foto saat diam; saat ada yang
 *   di-hover/difokus, hanya foto yang melebar yang menampilkan teksnya.
 * - Mobile: grid 2 kolom, nama + jabatan selalu terlihat (perangkat sentuh tidak punya hover).
 * - Lebar maksimum menyesuaikan jumlah anggota (--n), jadi divisi dengan 1–2 orang tidak jadi foto raksasa.
 * - Keyboard: setiap foto bisa difokus (tabindex=0). Hover mengalahkan fokus bila keduanya terjadi bersamaan.
 * - Setiap <li> memakai tabindex=0 agar bisa difokus keyboard; teksnya selalu ada di DOM, jadi terbaca pembaca layar tanpa fokus.
 * - Reduced motion: transisi dimatikan. NIM/kontak pribadi tidak pernah ditampilkan (PRD § 5.2).
 */
import { Image } from 'astro:assets';

interface Member {
  nama: string;
  jabatan: string;
  foto?: ImageMetadata;
}

interface Props {
  members: Member[];
  /** Label daftar untuk pembaca layar, mis. "Pengurus Inti" */
  label: string;
  class?: string;
}

const { members, label, class: className = '' } = Astro.props;

const monogram = (nama: string) =>
  nama
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
---

<ul class:list={['acc', className]} style={`--n:${members.length}`} aria-label={label}>
  {members.map((m) => (
    <li class="acc-item" tabindex="0">
      {m.foto ? (
        <Image
          src={m.foto}
          alt={`Foto ${m.nama}`}
          width={640}
          height={800}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        <div class="surface-ink flex h-full w-full items-center justify-center" aria-hidden="true">
          <span class="font-mono text-4xl font-medium tracking-wider text-white">{monogram(m.nama)}</span>
        </div>
      )}
      <div class="acc-text">
        <h3 class="font-heading text-base font-medium leading-snug text-white sm:text-lg">{m.nama}</h3>
        <p class="mt-0.5 text-sm text-mist-100">{m.jabatan}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .acc {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
    max-width: calc(var(--n) * 20rem);
  }

  .acc-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 1rem;
    background: var(--color-mist-100);
    outline: none;
  }
  .acc-item:focus-visible {
    outline: 2px solid var(--color-navy-900);
    outline-offset: 3px;
  }

  /* Gradasi navy di bawah foto agar teks putih tetap terbaca (hanya warna palet). */
  .acc-item::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 72%;
    background: linear-gradient(to top, rgb(30 39 59 / 0.92) 0%, rgb(30 39 59 / 0.62) 45%, rgb(30 39 59 / 0) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .acc-text {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 0.9rem;
    color: #fff;
  }

  /* Lapisan redup untuk foto yang menyempit */
  .acc-item::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: rgb(255 255 255 / 0.3);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    opacity: 0;
  }

  @media (min-width: 768px) {
    .acc {
      display: flex;
      gap: 0.5rem;
    }
    .acc-item {
      flex: 1 1 0%;
      min-width: 0;
      aspect-ratio: auto;
      height: 26rem;
    }
    .acc-text {
      padding: 1.1rem;
      white-space: nowrap;
    }

    /* Keadaan "ada yang aktif": hover lebih diutamakan daripada fokus. */
    .acc:has(.acc-item:hover) > .acc-item:not(:hover),
    .acc:not(:has(.acc-item:hover)):focus-within > .acc-item:not(:focus-within) {
      flex-grow: 0.22;
    }
    .acc:has(.acc-item:hover) > .acc-item:not(:hover)::after,
    .acc:not(:has(.acc-item:hover)):focus-within > .acc-item:not(:focus-within)::after {
      opacity: 1;
    }
    .acc:has(.acc-item:hover) > .acc-item:not(:hover) .acc-text,
    .acc:not(:has(.acc-item:hover)):focus-within > .acc-item:not(:focus-within) .acc-text {
      opacity: 0;
    }
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .acc-item {
      transition: flex-grow 0.35s cubic-bezier(0.5, 0.85, 0.25, 1.15);
    }
    .acc-item::after {
      transition: opacity 0.3s ease;
    }
    .acc-text {
      transition: opacity 0.2s ease;
    }
  }
</style>
