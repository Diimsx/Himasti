---
/**
 * Button — Primary, secondary, and pill button variants for light and dark backgrounds.
 * Minimum touch target 44px. Renders as <a> if href is provided, otherwise <button>.
 * See design.md § 4 and § 6 for specs.
 */
interface Props {
  /** Button variant */
  variant?: 'primary' | 'secondary' | 'pill';
  /** Background context — affects color scheme */
  on?: 'light' | 'dark';
  /** Shape style — rounded-xl (default) or rounded-full (pill) */
  shape?: 'default' | 'pill';
  /** Render as link */
  href?: string;
  /** Button type (when not a link) */
  type?: 'button' | 'submit';
  /** Additional CSS classes */
  class?: string;
  /** Open in new tab */
  external?: boolean;
}

const {
  variant = 'primary',
  on = 'light',
  shape,
  href,
  type = 'button',
  class: className = '',
  external = false,
} = Astro.props;

const Tag = href ? 'a' : 'button';

const isPill = variant === 'pill' || shape === 'pill';
const radiusClass = isPill ? 'rounded-full' : 'rounded-xl';

const baseClasses =
  `inline-flex items-center justify-center gap-2 ${radiusClass} px-6 font-semibold text-base transition-all duration-150 min-h-[44px] hover:-translate-y-[1px] focus-visible:outline-2 focus-visible:outline-offset-2`;

const variantClasses: Record<string, Record<string, string>> = {
  primary: {
    dark: 'bg-white text-navy-900 hover:bg-mist-100 focus-visible:outline-white',
    light: 'bg-navy-900 text-white hover:bg-navy-800 focus-visible:outline-navy-900',
  },
  secondary: {
    dark: 'border-[1.5px] border-gray-300 text-white hover:border-white hover:text-white focus-visible:outline-white',
    light: 'border-[1.5px] border-navy-900 text-navy-900 hover:bg-mist-50 focus-visible:outline-navy-900',
  },
  pill: {
    dark: 'bg-white text-navy-900 hover:bg-mist-100 focus-visible:outline-white',
    light: 'bg-navy-900 text-white hover:bg-navy-800 focus-visible:outline-navy-900',
  },
};

const classes = `${baseClasses} ${variantClasses[variant][on]} ${className}`;

const linkProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{Tag === 'a' ? (
  <a href={href} class={classes} {...linkProps}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
