---
/**
 * ProkerTile - Kartu ringkas program kerja untuk beranda: hanya nama proker dan deskripsi.
 * Seluruh kartu bisa diklik; ikon panah di kanan atas bersifat dekoratif.
 * Versi lengkap (kategori, status, waktu) tetap memakai ProkerCard di halaman Program Kerja.
 */
interface Props {
  judul: string;
  slug: string;
  ringkasan: string;
  class?: string;
}

const { judul, slug, ringkasan, class: className = '' } = Astro.props;
---

<a
  href={`/program-kerja/${slug}`}
  class:list={[
    'group flex items-start justify-between gap-4 rounded-[20px] border border-mist-100 bg-white p-5 sm:p-6 shadow-sm',
    'transition-[transform,box-shadow,border-color] duration-150',
    'motion-safe:hover:-translate-y-0.5 hover:shadow-md hover:border-slate-500',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-900',
    className,
  ]}
>
  <div class="min-w-0">
    <h3 class="font-heading text-lg font-medium text-navy-900">
      {judul}
    </h3>
    <p class="mt-1 text-sm leading-relaxed text-slate-700 line-clamp-2">
      {ringkasan}
    </p>
  </div>
  <svg
    class="mt-1 size-5 shrink-0 text-slate-500 transition-[transform,color] duration-150 group-hover:text-navy-900 motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M7 17 17 7M8 7h9v9" />
  </svg>
</a>
