---
/**
 * Hero — kartu membulat berkabut, judul dua nada di tengah, tombol bundar di kiri bawah.
 * Komposisi mengikuti referensi solation.eu; warna tetap dari palet HIMASTI (design.md § 2, 4.1).
 *
 * Zona kontras (design.md § 2.3): teks gelap hanya di 0–70% tinggi kartu. Blok teks digeser ke atas
 * dengan padding bawah agar pusatnya jatuh di ±40%. Zona 70–90% tidak memuat teks.
 * Kabut dan "ladang" di bawah murni hiasan (aria-hidden), dibuat dari CSS/SVG, tanpa foto stok.
 */
import { Image } from 'astro:assets';
import logoHimasti from '../../assets/logo-himasti.png';
import logoCyberUniversity from '../../assets/logo-cyber-university.png';
import logoKabinetArthasena from '../../assets/logo-kabinet-arthasena.png';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Garis alur ladang: kurva yang bergeser ke bawah, makin ke bawah makin rapat dan terang.
const furrows = Array.from({ length: 9 }, (_, i) => {
  const y = 40 + i * 26 + i * i * 1.5;
  const amp = 14 + i * 3;
  return {
    d: `M-20 ${y} C 260 ${y - amp}, 520 ${y + amp}, 760 ${y} S 1200 ${y - amp}, 1460 ${y + amp / 2}`,
    o: (0.1 + i * 0.03).toFixed(2),
  };
});
---

<section class:list={['px-2 lg:px-3 pt-2 lg:pt-3 pb-4', className]}>
  <div
    class="surface-mist rounded-[32px] lg:rounded-[40px] shadow-xl min-h-[calc(100svh-24px)] relative overflow-hidden flex flex-col items-center justify-center px-4"
  >
    <!-- Kabut: lapisan putih lembut di atas gradasi mist -->
    <div class="absolute inset-0 hero-fog pointer-events-none" aria-hidden="true"></div>

    <!-- Ladang: kurva halus di zona bawah (70–100%) -->
    <svg
      class="absolute inset-x-0 bottom-0 w-full h-[30%] text-gray-300 pointer-events-none"
      viewBox="0 0 1440 300"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      {furrows.map((f) => (
        <path d={f.d} fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" opacity={f.o} />
      ))}
    </svg>

    <!-- Konten: pusat blok di ±40% tinggi kartu (zona teks gelap) -->
    <div class="hero-content hero-entrance relative z-10 mx-auto max-w-4xl text-center pt-12 sm:pt-16 pb-[18svh] lg:pb-[14svh]">
      <!-- Tiga logo di atas judul: HIMASTI, Cyber University, Kabinet Arthasena -->
      <div class="flex flex-wrap items-center justify-center gap-x-5 sm:gap-x-8 gap-y-3 mb-6 lg:mb-8">
        <Image src={logoHimasti} alt="Logo HIMASTI" class="h-11 sm:h-16 lg:h-20 w-auto" loading="eager" />
        <Image src={logoCyberUniversity} alt="Logo Cyber University" class="h-9 sm:h-14 lg:h-16 w-auto" loading="eager" />
        <Image src={logoKabinetArthasena} alt="Logo Kabinet ArthaSena" class="h-9 sm:h-14 lg:h-16 w-auto" loading="eager" />
      </div>

      <h1 class="type-display text-balance">
        <span class="text-navy-900">Himpunan Mahasiswa</span><br />
        <span class="text-slate-700">Sistem &amp; Teknologi Informasi</span>
      </h1>

      <p class="type-body-lead text-slate-700 max-w-xl mx-auto mt-8">
        Cyber University · Periode 2026/2027
      </p>
    </div>

    <!-- Tombol bundar kiri bawah (zona putih 90–100%): gulir ke seksi berikutnya -->
    <a
      href="#mengenal"
      class="absolute left-4 bottom-4 lg:left-6 lg:bottom-6 z-10 inline-flex items-center justify-center size-11 rounded-full surface-glass text-white transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      aria-label="Gulir ke bagian Mengenal HIMASTI"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 5v14M6 13l6 6 6-6" />
      </svg>
    </a>
  </div>
</section>
