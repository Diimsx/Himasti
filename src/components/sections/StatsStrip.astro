---
/**
 * StatsStrip — Statistics strip showing verified numbers on white background with vertical dividers.
 * Verified numbers: 4 Divisi, 6 Program Kerja (PRD.md).
 */
import Container from '../ui/Container.astro';
import Stat from '../ui/Stat.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class:list={['bg-white border-y border-mist-100 py-10 lg:py-14', className]}>
  <Container>
    <div class="grid grid-cols-2 divide-x divide-mist-100 max-w-xl mx-auto">
      <Stat value="4" label="Divisi" dark={false} />
      <Stat value="6" label="Program Kerja" dark={false} />
    </div>
  </Container>
</section>
