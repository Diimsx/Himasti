---
/**
 * DivisiPreview — Preview of divisions on white background.
 * Fetches divisi content collection sorted by urutan.
 * Kartu bergaya "service card" 2 kolom; varian warna bergilir (ink, white, mist, slate).
 * Tanpa pil eyebrow dan tanpa tombol "Lihat Semua": setiap kartu sudah menaut ke /divisi#slug.
 */
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import DivisiTile from '../ui/DivisiTile.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const divisiEntries = await getCollection('divisi');
const sortedDivisi = divisiEntries.sort((a, b) => (a.data.urutan ?? 0) - (b.data.urutan ?? 0));
const variants = ['ink', 'white', 'mist', 'slate'] as const;
---

<section class:list={['bg-white py-20 lg:py-32', className]}>
  <Container>
    <SectionHeader
      title="Divisi Kepengurusan"
      description="Struktur divisi yang menjalankan roda organisasi dan program kerja HIMASTI."
    />

    {sortedDivisi.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
        {sortedDivisi.map((entry, idx) => (
          <div class="card-enter grid" style={`--i:${idx}`}>
            <DivisiTile
              nama={entry.data.nama}
              slug={entry.data.slug}
              variant={variants[idx % variants.length]}
            />
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-slate-700">
        Informasi divisi akan segera diperbarui.
      </p>
    )}
  </Container>
</section>
