---
/**
 * Timeline — Timeline/Roadmap jadwal program kerja periode 2026/2027.
 * Mengambil data dari koleksi proker, mengurutkan secara kronologis berdasarkan waktu.
 */
import { getCollection } from 'astro:content';
import Badge from '../ui/Badge.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const prokerEntries = await getCollection('proker');

const waktuOrder: Record<string, number> = {
  'Q2 2026': 1,
  'Q3 2026': 2,
  'Q4 2026': 3,
  'Sepanjang periode': 4,
};

const sorted = [...prokerEntries].sort(
  (a, b) => (waktuOrder[a.data.waktu] ?? 99) - (waktuOrder[b.data.waktu] ?? 99)
);

const statusVariant: Record<string, 'warning' | 'info' | 'success'> = {
  'akan-datang': 'warning',
  'berlangsung': 'info',
  'selesai': 'success',
};

const statusLabel: Record<string, string> = {
  'akan-datang': 'Akan Datang',
  'berlangsung': 'Berlangsung',
  'selesai': 'Selesai',
};
---

<div class:list={['relative max-w-3xl mx-auto', className]}>
  {sorted.length > 0 ? (
    <div class="relative pl-6 sm:pl-8 space-y-6 sm:space-y-8">
      <!-- Vertical line running down the left side -->
      <div
        class="absolute left-2.5 sm:left-3.5 top-3 bottom-3 w-0.5 bg-gray-300"
        aria-hidden="true"
      />

      {sorted.map((item) => (
        <div class="relative group">
          <!-- Dot on the line (12px circle, accent color) -->
          <div
            class="absolute -left-[19px] sm:-left-[23px] top-5 w-3 h-3 rounded-full bg-accent-light ring-4 ring-mist-100 group-hover:scale-125 transition-transform motion-reduce:transition-none"
            aria-hidden="true"
          />

          <!-- Timeline Node Card -->
          <div class="rounded-xl border border-gray-300 bg-white p-5 sm:p-6 transition-all duration-150 hover:-translate-y-0.5 hover:shadow-md hover:border-accent-light">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <span class="font-mono text-xs font-semibold text-accent-light tracking-wide">
                {item.data.waktu}
              </span>
              <Badge variant={statusVariant[item.data.status]}>
                {statusLabel[item.data.status]}
              </Badge>
            </div>

            <h3 class="font-heading text-lg sm:text-xl font-bold text-navy-900 mb-2">
              <a
                href={`/program-kerja/${item.data.slug}`}
                class="hover:text-accent-light transition-colors focus-visible:outline-2 focus-visible:outline-accent-light"
              >
                {item.data.judul}
              </a>
            </h3>

            <p class="text-sm text-slate-700 leading-relaxed">
              {item.data.ringkasan}
            </p>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <p class="text-center text-slate-700 py-8">
      Belum ada jadwal program kerja yang tersedia.
    </p>
  )}
</div>
