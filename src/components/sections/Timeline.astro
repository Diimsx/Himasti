---
/**
 * Timeline - Timeline / Roadmap jadwal program kerja periode 2026/2027.
 * Disajikan di dalam pulau gelap (surface-ink) dengan garis tengah zig-zag di desktop
 * dan single column di mobile. Mengikuti design.md § 6, 8.3.
 * Perilaku scroll (garis terisi, titik menyala, kartu naik) dikendalikan oleh src/lib/motion.ts
 * dan global.css; tanpa JS atau saat reduced motion semua item tampil final.
 *
 * Geometri garis: garis dimulai tepat di pusat titik pertama dan berakhir tepat di pusat titik
 * terakhir. Itu dicapai dengan menaruh garis di dalam grup "semua item kecuali terakhir" lalu
 * memanjangkannya ke bawah sebesar jarak antar item + 12 px (setengah tinggi baris titik),
 * sehingga tinggi item terakhir tidak mempengaruhi garis.
 */
import { getCollection } from 'astro:content';
import TimelineItem from './TimelineItem.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const prokerEntries = await getCollection('proker');

const waktuOrder: Record<string, number> = {
  'Q2 2026': 1,
  'Q3 2026': 2,
  'Q4 2026': 3,
  'Sepanjang periode': 4,
};

const sorted = [...prokerEntries].sort(
  (a, b) => (waktuOrder[a.data.waktu] ?? 99) - (waktuOrder[b.data.waktu] ?? 99)
);

const lastIndex = sorted.length - 1;
const head = sorted.slice(0, lastIndex);
const last = sorted[lastIndex];
---

<div data-timeline class:list={['relative max-w-4xl mx-auto [--tl-gap:2.5rem] md:[--tl-gap:3.5rem]', className]}>
  {sorted.length > 0 ? (
    <div class="relative py-2">
      {head.length > 0 && (
        <div class="relative flex flex-col gap-(--tl-gap)">
          <!-- Garis: dari pusat titik pertama (12 px) sampai pusat titik terakhir (jarak + 12 px di bawah grup) -->
          <div
            data-timeline-spine
            class="absolute left-3.5 md:left-1/2 -translate-x-1/2 top-3 bottom-[calc(-1*var(--tl-gap)-0.75rem)] w-0.5 overflow-hidden rounded-full bg-white/20"
            aria-hidden="true"
          >
            <!-- Isian garis (§ 8.3, 11.2) -->
            <div class="absolute inset-0 bg-white timeline-fill origin-top"></div>
          </div>

          {head.map((item, idx) => (
            <TimelineItem
              judul={item.data.judul}
              slug={item.data.slug}
              ringkasan={item.data.ringkasan}
              waktu={item.data.waktu}
              status={item.data.status}
              even={idx % 2 === 0}
            />
          ))}
        </div>
      )}

      <div class:list={[head.length > 0 && 'mt-(--tl-gap)']}>
        <TimelineItem
          judul={last.data.judul}
          slug={last.data.slug}
          ringkasan={last.data.ringkasan}
          waktu={last.data.waktu}
          status={last.data.status}
          even={lastIndex % 2 === 0}
        />
      </div>
    </div>
  ) : (
    <p class="text-center text-gray-300 py-8">
      Belum ada jadwal program kerja yang tersedia.
    </p>
  )}
</div>
