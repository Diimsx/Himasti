---
/**
 * Timeline — Timeline / Roadmap jadwal program kerja periode 2026/2027.
 * Disajikan di dalam pulau gelap (surface-ink) dengan garis tengah zig-zag di desktop
 * dan single column di mobile. Mengikuti design.md § 6, 8.3.
 * Perilaku scroll (garis terisi, titik menyala, kartu naik) dikendalikan oleh src/lib/motion.ts
 * dan global.css; tanpa JS atau saat reduced motion semua item tampil final.
 */
import { getCollection } from 'astro:content';
import Badge from '../ui/Badge.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const prokerEntries = await getCollection('proker');

const waktuOrder: Record<string, number> = {
  'Q2 2026': 1,
  'Q3 2026': 2,
  'Q4 2026': 3,
  'Sepanjang periode': 4,
};

const sorted = [...prokerEntries].sort(
  (a, b) => (waktuOrder[a.data.waktu] ?? 99) - (waktuOrder[b.data.waktu] ?? 99)
);

const statusVariant: Record<string, 'akan-datang' | 'berlangsung' | 'selesai'> = {
  'akan-datang': 'akan-datang',
  'berlangsung': 'berlangsung',
  'selesai': 'selesai',
};

const statusLabel: Record<string, string> = {
  'akan-datang': 'Akan Datang',
  'berlangsung': 'Berlangsung',
  'selesai': 'Selesai',
};
---

<div data-timeline class:list={['relative max-w-4xl mx-auto', className]}>
  {sorted.length > 0 ? (
    <div class="relative py-4 space-y-10 md:space-y-14">
      <!-- Vertical timeline spine: left on mobile, center on desktop -->
      <div
        data-timeline-spine
        class="absolute left-3.5 md:left-1/2 -translate-x-1/2 top-3 bottom-3 w-0.5 bg-white/20"
        aria-hidden="true"
      >
        <!-- Timeline fill overlay (§ 8.3, 11.2) -->
        <div class="absolute inset-0 bg-white timeline-fill origin-top" aria-hidden="true" />
      </div>

      {sorted.map((item, idx) => {
        const isEven = idx % 2 === 0;
        const itemNumber = String(idx + 1).padStart(2, '0');

        return (
          <div class="tl-item relative flex flex-col md:flex-row items-start group">
            <!-- Dot on line (w-3 h-3, bg-white, ring-4 ring-navy-900) -->
            <div
              class="tl-dot absolute left-3.5 md:left-1/2 -translate-x-1/2 top-1.5 w-3 h-3 rounded-full bg-white ring-4 ring-navy-900 z-10 transition-transform group-hover:scale-125 motion-reduce:transition-none"
              aria-hidden="true"
            />

            <!-- Timeline Content Node: alternating left/right on desktop, single column on mobile -->
            <div
              class:list={[
                'tl-body w-full pl-10 md:pl-0 md:w-1/2',
                isEven
                  ? 'md:pr-12 md:text-right md:mr-auto'
                  : 'md:pl-12 md:text-left md:ml-auto',
              ]}
            >
              <!-- Meta Row: Number + Waktu + Badge -->
              <div
                class:list={[
                  'flex flex-wrap items-center gap-2.5 mb-2',
                  isEven ? 'md:justify-end' : 'md:justify-start',
                ]}
              >
                <!-- Number: mono small above H3 -->
                <span
                  class:list={[
                    'tl-dim font-mono text-xs font-semibold tracking-wider text-white',
                  ]}
                >
                  {itemNumber}
                </span>

                <span class="text-gray-300 text-xs" aria-hidden="true">·</span>

                <!-- Waktu label: text-gray-300 font-mono text-xs -->
                <span class="text-gray-300 font-mono text-xs">
                  {item.data.waktu}
                </span>

                <!-- Status Badge (Badge handles its own pulse dot for berlangsung and check icon for selesai) -->
                <Badge variant={statusVariant[item.data.status]} on="dark">
                  {statusLabel[item.data.status]}
                </Badge>
              </div>

              <!-- Title (H3) -->
              <h3
                class:list={[
                  'tl-dim font-heading text-lg sm:text-xl font-medium tracking-tight mb-2 text-white',
                ]}
              >
                <a
                  href={`/program-kerja/${item.data.slug}`}
                  class="hover:underline text-inherit transition-colors focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
                >
                  {item.data.judul}
                </a>
              </h3>

              <!-- Summary Description -->
              <p
                class:list={[
                  'tl-dim text-sm leading-relaxed max-w-prose text-gray-300',
                  isEven && 'md:ml-auto',
                ]}
              >
                {item.data.ringkasan}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  ) : (
    <p class="text-center text-gray-300 py-8">
      Belum ada jadwal program kerja yang tersedia.
    </p>
  )}
</div>
