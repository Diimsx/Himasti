---
/**
 * CTABand — Call-to-action section on navy-800 background.
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<Section bg="navy-800" class={className}>
  <Container>
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-white leading-tight">
        Tertarik Bergabung dengan HIMASTI?
      </h2>
      <p class="mt-4 text-base md:text-lg text-gray-300 leading-relaxed">
        Jadilah bagian dari keluarga besar Sistem &amp; Teknologi Informasi Cyber University.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
        <Button variant="primary" on="dark" href="/kontak">
          Gabung Sekarang
        </Button>
        <Button variant="secondary" on="dark" href="/kontak">
          Hubungi Kami
        </Button>
      </div>
    </div>
  </Container>
</Section>
