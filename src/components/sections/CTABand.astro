---
/**
 * CTABand — Call-to-action island banner with ink gradient, sheen, and ink-glow.
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class:list={['px-2 lg:px-3 py-4', className]}>
  <div class="surface-ink rounded-[32px] lg:rounded-[40px] shadow-xl relative overflow-hidden">
    <!-- Sheen overlay (§ 3.3, 8.6) -->
    <div class="absolute inset-0 bg-sheen pointer-events-none" aria-hidden="true"></div>
    <!-- Ink glow corner highlight (§ 3.3) -->
    <div class="absolute inset-0 ink-glow pointer-events-none" aria-hidden="true"></div>

    <Container class="relative z-10 py-20 lg:py-32">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-medium text-white text-center leading-tight">
          Ada Pertanyaan atau Ingin Berkolaborasi?
        </h2>
        <p class="mt-4 text-base md:text-lg text-gray-300 leading-relaxed max-w-xl mx-auto">
          Hubungi HIMASTI untuk informasi kegiatan, kerja sama, atau kebutuhan lainnya.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mt-8 lg:mt-10">
          <a
            href="/kontak"
            class="group surface-glass rounded-full px-8 py-3 text-white font-medium inline-flex items-center gap-2 hover:bg-white/15 transition-colors focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
          >
            <span>Hubungi Kami</span>
            <svg
              class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-[3px] motion-reduce:transform-none"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </a>
        </div>
      </div>
    </Container>
  </div>
</section>
