---
/**
 * Footer — navy-900 footer with giant wordmark marquee, hak cipta + ikon
 * Instagram / LinkedIn / Email (kolom kiri), dan 2 kolom sitemap (design.md § 6, 8.5). Data kontak dari src/content/settings.json.
 */
import Container from '../ui/Container.astro';
import SocialIcon from '../ui/SocialIcon.astro';
import { getContactLinks } from '../../lib/contact';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Beranda', href: '/' },
  { label: 'Tentang Kami', href: '/tentang' },
  { label: 'Struktur Organisasi', href: '/struktur' },
  { label: 'Kontak', href: '/kontak' },
];

const programLinks = [
  { label: 'Program Kerja', href: '/program-kerja' },
  { label: 'Berita', href: '/berita' },
];

const contactLinks = getContactLinks(); // instagram, linkedin, email (yang terisi di settings.json)
---

<footer class="bg-navy-900 text-white">
  <!-- Wordmark marquee (§ 8.5): decorative. Track is w-max and each copy carries its own right padding,
       so translateX(-50%) lands exactly on the start of the second half (seamless loop). -->
  <Container>
    <div class="lg:w-[70%] lg:mx-auto overflow-hidden py-12 lg:py-16" aria-hidden="true">
      <div class="wordmark">
        <div class="marquee-track flex w-max whitespace-nowrap">
          {Array.from({ length: 8 }).map(() => (
            <span class="pr-[0.4em] text-[20vw] lg:text-[16vw] font-heading font-medium text-gray-300 select-none leading-none">HIMASTI</span>
          ))}
        </div>
      </div>
    </div>
  </Container>

  <Container>
    <!-- Isi footer: di desktop selebar 70% Container (30% lebih pendek dari lebar konten seksi lain) -->
    <div class="lg:w-[70%] lg:mx-auto">
    <div class="py-12 lg:py-16 grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-8">
      <!-- Hak cipta + ikon kontak: kolom kiri, di samping Navigasi (di HP turun ke akhir) -->
      <div class="order-last md:order-first space-y-2 text-gray-300">
        <p class="type-caption">
          &copy; {currentYear} HIMASTI Cyber University. Seluruh hak dilindungi.
        </p>
        <!-- Ikon kontak: Instagram, LinkedIn, Email (di bawah hak cipta) -->
        <ul class="flex items-center gap-1 -ml-3 pt-1" role="list" aria-label="Kontak dan media sosial">
          {contactLinks.map(({ name, label, href }) => (
            <li>
              <a
                href={href}
                target={name === 'email' ? undefined : '_blank'}
                rel={name === 'email' ? undefined : 'noopener noreferrer'}
                class="inline-flex items-center justify-center w-11 h-11 rounded-full text-gray-300 hover:text-white hover:bg-white/10 transition-colors focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
                aria-label={name === 'email' ? label : `${label} (tab baru)`}
              >
                <SocialIcon name={name} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav aria-label="Navigasi footer">
        <h2 class="text-white text-sm font-medium mb-4">Navigasi</h2>
        <ul class="space-y-1" role="list">
          {quickLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="inline-block py-1 text-sm text-gray-300 hover:text-white transition-colors rounded focus-visible:outline-2 focus-visible:outline-white">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Program dan informasi">
        <h2 class="text-white text-sm font-medium mb-4">Program</h2>
        <ul class="space-y-1" role="list">
          {programLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="inline-block py-1 text-sm text-gray-300 hover:text-white transition-colors rounded focus-visible:outline-2 focus-visible:outline-white">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    </div>
  </Container>
</footer>
