---
/**
 * Footer — Full-width navy-900 footer with giant wordmark marquee, 3-column sitemap, contact, and copyright.
 * HIMASTI v3 "Layered Clean Tech" (design.md § 6, 8.5).
 */
import Container from '../ui/Container.astro';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Beranda', href: '/' },
  { label: 'Tentang Kami', href: '/tentang' },
  { label: 'Struktur', href: '/struktur' },
  { label: 'Divisi', href: '/divisi' },
];

const programLinks = [
  { label: 'Program Kerja', href: '/program-kerja' },
  { label: 'Berita', href: '/berita' },
  { label: 'Galeri', href: '/galeri' },
  { label: 'Prestasi', href: '/prestasi' },
];

// Official organization contact and social links
const socialLinks = [
  { label: 'Instagram', href: '#', icon: 'instagram' },
  { label: 'LinkedIn', href: '#', icon: 'linkedin' },
  { label: 'Email', href: 'mailto:himasti@cyber.ac.id', icon: 'email' },
];
---

<footer class="bg-navy-900 text-white border-t border-white/10">
  <!-- Wordmark marquee section (§ 6, 8.5) -->
  <div class="overflow-hidden py-12 lg:py-16 border-b border-white/10" aria-hidden="true">
    <div class="wordmark">
      <div class="marquee-track flex whitespace-nowrap gap-8">
        {/* Repeat HIMASTI text 8+ times for seamless loop */}
        {Array.from({ length: 8 }).map(() => (
          <span class="text-[20vw] lg:text-[16vw] font-heading font-medium text-gray-300 select-none leading-none">HIMASTI</span>
        ))}
      </div>
    </div>
  </div>

  <Container>
    <!-- 3-column sitemap: Navigasi, Program, Kontak -->
    <div class="py-12 lg:py-16 grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-8">
      <!-- Navigasi -->
      <div>
        <h3 class="text-white text-sm font-medium mb-4">
          Navigasi
        </h3>
        <ul class="space-y-2" role="list">
          {quickLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="text-sm text-gray-300 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white focus-visible:rounded"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Program -->
      <div>
        <h3 class="text-white text-sm font-medium mb-4">
          Program
        </h3>
        <ul class="space-y-2" role="list">
          {programLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="text-sm text-gray-300 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white focus-visible:rounded"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Kontak -->
      <div>
        <h3 class="text-white text-sm font-medium mb-4">
          Kontak
        </h3>
        <address class="not-italic text-sm text-gray-300 space-y-2">
          <p>Cyber University</p>
          <p>
            <a href="mailto:himasti@cyber.ac.id" class="text-gray-300 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white focus-visible:rounded">
              himasti@cyber.ac.id
            </a>
          </p>
        </address>

        <!-- Social icons -->
        <div class="flex items-center gap-3 mt-5">
          {socialLinks.map(({ label, href }) => (
            <a
              href={href}
              class="p-2 rounded-lg text-gray-300 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white"
              aria-label={label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5" />
                <text x="12" y="16" text-anchor="middle" font-size="10" fill="currentColor">
                  {label.charAt(0)}
                </text>
              </svg>
            </a>
          ))}
        </div>

        <div class="mt-4">
          <a
            href="/kontak"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-white underline hover:text-gray-300 transition-colors focus-visible:outline-2 focus-visible:outline-white"
          >
            Hubungi Kami
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright bar -->
    <div class="border-t border-white/10 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-gray-300">
        &copy; {currentYear} HIMASTI Cyber University. Seluruh hak dilindungi.
      </p>
      <p class="text-xs text-gray-300 font-mono">
        Periode 2026/2027
      </p>
    </div>
  </Container>
</footer>
