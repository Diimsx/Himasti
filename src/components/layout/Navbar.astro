---
/**
 * Navbar — Floating glass pill navigation with logo, links, CTA, and mobile drawer.
 * Height 52px mobile / 56px desktop, keyboard-friendly, floating nav-pill (design.md § 6).
 * Mobile menu uses <dialog> for focus trapping without JS framework.
 */
import { Image } from 'astro:assets';
import logoHimasti from '../../assets/logo-himasti.png';

interface NavLink {
  label: string;
  href: string;
}

const navLinks: NavLink[] = [
  { label: 'Beranda', href: '/' },
  { label: 'Tentang', href: '/tentang' },
  { label: 'Struktur', href: '/struktur' },
  { label: 'Divisi', href: '/divisi' },
  { label: 'Program Kerja', href: '/program-kerja' },
  { label: 'Berita', href: '/berita' },
  { label: 'Kontak', href: '/kontak' },
];

// Desktop displays 5 core navigation links to fit inside the 520px floating pill (design.md § 5, 6).
// Beranda is accessible via the logo, and Kontak via the "Gabung" CTA pill.
const desktopNavLinks: NavLink[] = [
  { label: 'Tentang', href: '/tentang' },
  { label: 'Struktur', href: '/struktur' },
  { label: 'Divisi', href: '/divisi' },
  { label: 'Proker', href: '/program-kerja' },
  { label: 'Berita', href: '/berita' },
];

const currentPath = Astro.url.pathname;
---

<nav
  class="fixed top-3 lg:top-4 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-24px)] lg:w-auto lg:max-w-[520px] nav-pill rounded-full shadow-lg nav-entrance h-[52px] lg:h-[56px]"
  aria-label="Navigasi utama"
>
  <div class="flex items-center justify-between px-4 lg:px-5 h-full gap-2">
    <!-- Logo: white, only icon on mobile, icon+text on desktop -->
    <a
      href="/"
      class="flex items-center gap-2 text-white font-heading font-medium text-base shrink-0 focus-visible:outline-2 focus-visible:outline-white rounded"
      aria-label="HIMASTI Beranda"
    >
      <Image src={logoHimasti} alt="Logo HIMASTI" class="h-7 w-auto" />
      <span class="hidden lg:inline">HIMASTI</span>
    </a>

    <!-- Desktop links: 4-5 links in 520px pill -->
    <ul class="hidden lg:flex items-center gap-1 xl:gap-2" role="list">
      {desktopNavLinks.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class:list={[
                'px-2 py-1 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-white focus-visible:rounded',
                isActive
                  ? 'text-white underline underline-offset-4 decoration-2'
                  : 'text-white/80 hover:text-white',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Desktop CTA pill -->
    <div class="hidden lg:block shrink-0">
      <a
        href="/kontak"
        class="inline-flex items-center justify-center bg-white text-navy-900 hover:bg-mist-100 rounded-full px-4 py-1.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-white"
      >
        Gabung
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      type="button"
      id="mobile-menu-open"
      class="lg:hidden p-2 rounded-lg text-gray-300 hover:text-white focus-visible:outline-2 focus-visible:outline-white"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile drawer -->
<dialog
  id="mobile-menu"
  class="fixed inset-0 z-50 m-0 h-full w-full max-h-none max-w-none bg-navy-900 p-0 text-white open:flex open:flex-col"
>
  <div class="flex items-center justify-between h-16 px-4 sm:px-6 border-b border-white/10">
    <a href="/" class="flex items-center gap-2.5 font-heading font-medium text-lg text-white focus-visible:outline-2 focus-visible:outline-white rounded">
      <Image src={logoHimasti} alt="Logo HIMASTI" class="h-9 w-auto" />
      <span>HIMASTI</span>
    </a>
    <button
      type="button"
      id="mobile-menu-close"
      class="p-2 rounded-lg text-gray-300 hover:text-white focus-visible:outline-2 focus-visible:outline-white"
      aria-label="Tutup menu navigasi"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <ul class="flex-1 overflow-y-auto px-4 sm:px-6 py-6 space-y-1" role="list">
    {navLinks.map(({ label, href }) => {
      const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
      return (
        <li>
          <a
            href={href}
            class:list={[
              'block px-4 py-3 rounded-lg text-base font-medium transition-colors focus-visible:outline-2 focus-visible:outline-white',
              isActive
                ? 'bg-navy-800 text-white'
                : 'text-gray-300 hover:text-white hover:bg-navy-800',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      );
    })}
  </ul>
  <div class="px-4 sm:px-6 pb-6">
    <a
      href="/kontak"
      class="block w-full py-3 rounded-full text-center font-medium bg-white text-navy-900 hover:bg-mist-100 transition-colors focus-visible:outline-2 focus-visible:outline-white"
    >
      Gabung
    </a>
  </div>
</dialog>

<script>
  const openBtn = document.getElementById('mobile-menu-open') as HTMLButtonElement;
  const closeBtn = document.getElementById('mobile-menu-close') as HTMLButtonElement;
  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement;

  openBtn?.addEventListener('click', () => {
    dialog?.showModal();
    openBtn.setAttribute('aria-expanded', 'true');
  });

  closeBtn?.addEventListener('click', () => {
    dialog?.close();
    openBtn.setAttribute('aria-expanded', 'false');
    openBtn.focus();
  });

  dialog?.addEventListener('close', () => {
    openBtn.setAttribute('aria-expanded', 'false');
  });

  // Close on backdrop click
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      dialog.close();
    }
  });
</script>
