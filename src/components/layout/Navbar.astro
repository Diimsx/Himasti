---
/**
 * Navbar - tombol pil kaca cair (liquid glass) "Menu +" khusus di pojok kanan atas (design.md § 6) + panel menu melengkung.
 *
 * Tidak ada logo atau tautan di tengah: seluruh navigasi ada di panel yang dibuka tombol ini.
 * Panel adalah <dialog> native (fokus terkunci, Esc, halaman di belakang inert) dengan transisi CSS
 * + skrip kecil untuk kurva SVG — tanpa React / framer-motion / Next.
 */
import SocialIcon from '../ui/SocialIcon.astro';
import { getContactLinks } from '../../lib/contact';

interface NavLink {
  label: string;
  href: string;
}

// Full list shown inside the curved menu
const menuLinks: NavLink[] = [
  { label: 'Beranda', href: '/' },
  { label: 'Tentang', href: '/tentang' },
  { label: 'Struktur', href: '/struktur' },
  { label: 'Program Kerja', href: '/program-kerja' },
  { label: 'Berita', href: '/berita' },
  { label: 'Galeri', href: '/galeri' },
  { label: 'Prestasi', href: '/prestasi' },
  { label: 'Kontak', href: '/kontak' },
];

const contactLinks = getContactLinks();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav
  id="site-nav"
  class="fixed top-3 right-3 lg:top-4 lg:right-4 z-50 nav-pill rounded-full nav-entrance h-[52px] lg:h-[56px]"
  aria-label="Navigasi utama"
  data-scrolled="false"
>
  <button
    type="button"
    id="menu-open"
    class="inline-flex items-center justify-center gap-2.5 h-full min-w-11 pl-5 pr-4 lg:pl-6 lg:pr-5 rounded-full text-white font-heading font-medium text-base [text-shadow:0_1px_2px_rgb(30_39_59/0.45)] hover:bg-white/10 active:scale-95 transition-[background-color,transform] duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    aria-label="Buka menu navigasi"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="site-menu"
  >
    <span>Menu</span>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-width="2" d="M12 5v14M5 12h14" />
    </svg>
  </button>
</nav>

<dialog id="site-menu" class="menu-dialog" aria-label="Menu navigasi" data-state="closed">
  <div class="menu-panel" data-deco="">
    <svg class="menu-curve" aria-hidden="true" focusable="false">
      <path id="menu-curve-path"></path>
    </svg>

    <!-- Dekorasi latar yang berganti sesuai item yang di-hover; murni hiasan, hanya warna palet -->
    <div class="menu-decor" aria-hidden="true">
      <svg viewBox="0 0 640 900" preserveAspectRatio="xMidYMax slice" focusable="false">
        <circle cx="470" cy="690" r="120" fill="currentColor" class="text-slate-700" opacity="0.5" />
        <circle cx="150" cy="800" r="72" fill="currentColor" class="text-navy-800" />
        <circle cx="330" cy="600" r="38" fill="currentColor" class="text-slate-700" opacity="0.35" />
      </svg>
      <svg viewBox="0 0 640 900" preserveAspectRatio="xMidYMax slice" focusable="false">
        <path d="M-20 560 C 120 500 220 640 360 590 S 580 520 680 600" fill="none" stroke="currentColor" stroke-width="48" class="text-slate-700" opacity="0.45" />
        <path d="M-20 660 C 120 600 220 740 360 690 S 580 620 680 700" fill="none" stroke="currentColor" stroke-width="48" class="text-navy-800" />
      </svg>
      <svg viewBox="0 0 640 900" preserveAspectRatio="xMidYMax slice" focusable="false">
        <g transform="rotate(-45 320 560)" fill="currentColor" class="text-slate-700">
          <rect x="-200" y="470" width="1200" height="34" opacity="0.45" />
          <rect x="-200" y="560" width="1200" height="34" opacity="0.3" />
          <rect x="-200" y="650" width="1200" height="34" opacity="0.2" />
        </g>
      </svg>
      <svg viewBox="0 0 640 900" preserveAspectRatio="xMidYMax slice" focusable="false">
        <g fill="currentColor" class="text-gray-300">
          <circle cx="90" cy="560" r="9" opacity="0.25" />
          <circle cx="260" cy="640" r="6" opacity="0.2" />
          <circle cx="430" cy="580" r="12" opacity="0.2" />
          <circle cx="540" cy="720" r="7" opacity="0.25" />
          <circle cx="180" cy="770" r="12" opacity="0.15" />
          <circle cx="380" cy="810" r="8" opacity="0.2" />
        </g>
      </svg>
    </div>

    <div class="flex items-center justify-end px-8 sm:px-14 pt-6 pb-4 menu-item" style="--i:0">
      <button
        type="button"
        id="menu-close"
        class="inline-flex items-center justify-center w-11 h-11 rounded-full text-white hover:bg-white/10 transition-colors focus-visible:outline-2 focus-visible:outline-white"
        aria-label="Tutup menu navigasi"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <div class="menu-scroll">
      <ul role="list">
        {menuLinks.map(({ label, href }, idx) => (
          <li class="menu-row" style={`--i:${idx}`}>
            <a
              href={href}
              class="menu-link menu-pad"
              data-deco={idx % 4}
              data-dir="bottom"
              aria-current={isCurrent(href) ? 'page' : undefined}
            >
              <span class="menu-clip">
                <span class="menu-text type-menu text-white">{label}</span>
              </span>
              <span class="menu-hover menu-pad" aria-hidden="true">
                <span class="type-menu text-navy-900">{label}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="px-8 sm:px-14 py-6 border-t border-white/10 menu-item flex items-center justify-between gap-4" style={`--i:${menuLinks.length}`}>
      <ul class="flex items-center gap-1" role="list">
        {contactLinks.map(({ name, label, href }) => (
          <li>
            <a
              href={href}
              class="inline-flex items-center justify-center w-11 h-11 rounded-full text-gray-300 hover:text-white hover:bg-white/10 transition-colors focus-visible:outline-2 focus-visible:outline-white"
              aria-label={label}
              {...(name !== 'email' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <SocialIcon name={name} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</dialog>

<script>
  const openBtn = document.getElementById('menu-open') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('menu-close') as HTMLButtonElement | null;
  const dialog = document.getElementById('site-menu') as HTMLDialogElement | null;
  const curve = document.getElementById('menu-curve-path');

  // Kilau liquid glass mengikuti kursor (CSS: --mx / --my pada .nav-pill)
  const navPill = document.getElementById('site-nav');
  navPill?.addEventListener('pointermove', (e) => {
    const r = navPill.getBoundingClientRect();
    navPill.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
    navPill.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
  });

  if (openBtn && closeBtn && dialog && curve) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ENTER_MS = 1000;
    const EXIT_MS = 800;
    // easeInOutCubic-like (≈ cubic-bezier(.76,0,.24,1))
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    let rafId = 0;
    let closing = false;

    // Leading edge: control point x goes from -100 (bulged) to 100 (flat)
    function drawCurve(qx: number) {
      const h = window.innerHeight;
      curve!.setAttribute('d', `M100 0 L200 0 L200 ${h} L100 ${h} Q${qx} ${h / 2} 100 0`);
    }

    function animateCurve(from: number, to: number, ms: number) {
      cancelAnimationFrame(rafId);
      if (reduce.matches) { drawCurve(to); return; }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        drawCurve(from + (to - from) * ease(t));
        if (t < 1) rafId = requestAnimationFrame(step);
      };
      rafId = requestAnimationFrame(step);
    }

    function open() {
      if (dialog!.open) return;
      closing = false;
      drawCurve(-100);
      dialog!.showModal();
      openBtn!.setAttribute('aria-expanded', 'true');
      // two frames so the browser registers the initial (off-screen) state before transitioning
      requestAnimationFrame(() => requestAnimationFrame(() => {
        dialog!.dataset.state = 'open';
        animateCurve(-100, 100, ENTER_MS);
      }));
    }

    function close() {
      if (!dialog!.open || closing) return;
      closing = true;
      dialog!.dataset.state = 'closed';
      animateCurve(100, -100, EXIT_MS);
      window.setTimeout(() => {
        dialog!.close();
        openBtn!.setAttribute('aria-expanded', 'false');
        openBtn!.focus();
        closing = false;
      }, reduce.matches ? 0 : EXIT_MS);
    }

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    // Esc: run the animated close instead of the instant native one
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });

    // Click outside the panel (on the transparent dialog area)
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });

    // Menu rows: the light band sweeps in from the side the pointer entered and leaves toward the side
    // it exits; the decoration behind the list follows the active row.
    const panel = dialog.querySelector<HTMLElement>('.menu-panel');
    dialog.querySelectorAll<HTMLAnchorElement>('.menu-link').forEach((link) => {
      const band = link.querySelector<HTMLElement>('.menu-hover');
      const side = (e: PointerEvent) => {
        const r = link.getBoundingClientRect();
        return e.clientY < r.top + r.height / 2 ? 'top' : 'bottom';
      };
      const setDeco = () => panel?.setAttribute('data-deco', link.dataset.deco ?? '');

      link.addEventListener('pointerenter', (e) => {
        if (band) band.style.transition = 'none';
        link.dataset.dir = side(e);
        if (band) { void band.offsetWidth; band.style.transition = ''; }
        link.classList.add('is-on');
        setDeco();
      });
      link.addEventListener('pointerleave', (e) => {
        link.dataset.dir = side(e);
        link.classList.remove('is-on');
      });
      link.addEventListener('focus', () => {
        if (link.matches(':focus-visible')) { link.classList.add('is-on'); setDeco(); }
      });
      link.addEventListener('blur', () => link.classList.remove('is-on'));
    });
  }
</script>
